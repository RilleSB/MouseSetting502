import { Theme } from "theme.slint";

export component KeybindRow inherits Rectangle {
    in property <string> button_id: "";
    in property <string> button_label: "";
    in property <string> default_action: "";
    in property <string> assigned_macro: "";
    in property <bool> is_mouse: false;
    in property <string> assigned_label: "";
    callback assign();
    callback clear();

    min-width: 0px;
    vertical-stretch: 0;
    border-radius: Theme.radius_base;
    background: root.assigned_macro != "" ? Theme.success_subtle : Theme.card_bg_subtle;
    border-width: 1px;
    border-color: root.assigned_macro != "" ? Theme.success_border : Theme.border_subtle;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 40px;
                height: 28px;
                border-radius: Theme.radius_md;
                background: root.is_mouse ? Theme.accent_light : Theme.purple_subtle;
                border-width: 1px;
                border-color: root.is_mouse ? Theme.accent_border : Theme.purple_border;
                Text {
                    text: root.button_id;
                    font-size: Theme.font_body_sm;
                    font-weight: 800;
                    color: root.is_mouse ? Theme.accent : Theme.purple_text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                min-width: 0px;
                horizontal-stretch: 1;
                text: root.button_label;
                wrap: word-wrap;
                font-size: Theme.font_body;
                font-weight: 700;
                color: Theme.text_primary;
                vertical-alignment: center;
            }
        }
        Text {
            min-width: 0px;
            text: root.assigned_macro == "__DPI_DOWN__" ? "Назначено: DPI вниз" :
                  root.assigned_macro == "__DPI_UP__" ? "Назначено: DPI вверх" :
                  root.assigned_macro != "" ? ("Назначено: " + root.assigned_label) : ("По умолчанию: " + root.default_action);
            wrap: word-wrap;
            font-size: Theme.font_body_sm;
            color: root.assigned_macro != "" ? Theme.success : Theme.text_secondary;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Rectangle {
                height: 30px;
                border-radius: Theme.radius_md;
                background: Theme.surface_btn;
                border-width: 1px;
                border-color: Theme.border_btn_hover;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.assigned_macro != "" ? "Изменить" : "Назначить";
                        font-size: Theme.font_body_sm;
                        font-weight: 700;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.assign(); } }
            }
            if root.assigned_macro != "" : Rectangle {
                height: 30px;
                border-radius: Theme.radius_md;
                background: Theme.error_subtle;
                border-width: 1px;
                border-color: Theme.error_border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: "Сбросить";
                        font-size: Theme.font_body_sm;
                        font-weight: 700;
                        color: Theme.error_text;
                        vertical-alignment: center;
                    }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.clear(); } }
            }
        }
    }
}
