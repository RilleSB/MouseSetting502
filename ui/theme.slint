export global Theme {
    // App & Layout backgrounds
    in property <color> app_bg: #000000;
    in property <color> header_bg: #000000;
    in property <color> sidebar_bg: #000000;
    in property <color> card_bg: #212224;
    in property <color> card_bg_subtle: #212224;
    in property <color> card_hover: #2b2c2e;
    in property <color> surface: #27282a;
    in property <color> surface_alt: #303133;
    in property <color> surface_active: #303133;
    in property <color> surface_subtle: #212224;
    in property <color> surface_elevated: #393a3c;
    in property <color> surface_btn: #393a3c;
    in property <color> surface_step: #27282a;
    in property <color> overlay: #000000dd;

    // Accent colors (Logitech Cyan / Neon)
    in property <color> accent: #009eff;
    in property <color> accent_subtle: #009eff18;
    in property <color> accent_light: #009eff22;
    in property <color> accent_border: #009eff66;
    in property <color> accent_secondary: #26e6be;
    in property <color> accent_teal: #153939;

    // Status colors
    in property <color> success: #00ce88;
    in property <color> success_subtle: #00ce8812;
    in property <color> success_border: #00ce8866;
    in property <color> success_dot: #00e676;
    in property <color> success_bg: #062b1a;

    in property <color> error: #ff3344;
    in property <color> error_bright: #ff5252;
    in property <color> error_subtle: #2b1115;
    in property <color> error_border: #ff3344;
    in property <color> error_btn_bg: #331d22;
    in property <color> error_text: #fca5a5;

    in property <color> warning: #ffb300;
    in property <color> warning_subtle: #3b2812;

    in property <color> purple: #9d4edd;
    in property <color> purple_subtle: #9d4edd22;
    in property <color> purple_border: #9d4edd66;
    in property <color> purple_text: #d8b4fe;

    // Headset colors
    in property <color> headset_bg_connected: #122438;
    in property <color> headset_bg_disconnected: #212224;
    in property <color> headset_border_disconnected: #273042;

    // Badges & Step elements
    in property <color> badge_custom_bg: #183354;
    in property <color> step_btn_bg: #222d3d;
    in property <color> swatch_border_unselected: #ffffff44;

    // Borders & dividers
    in property <color> divider: #303133;
    in property <color> border_subtle: #363739;
    in property <color> border_default: #3b3c3e;
    in property <color> border_card: #303133;
    in property <color> border_btn: #444547;
    in property <color> border_btn_hover: #666769;
    in property <color> border_active: #555658;
    in property <color> border_light: #555658;

    // Text colors
    in property <color> text_primary: #ffffff;
    in property <color> text_heading: #f1f5f9;
    in property <color> text_secondary: #adaeb2;
    in property <color> text_muted: #77787b;
    in property <color> text_subtle: #88898c;
    in property <color> text_inactive: #999a9c;
    in property <color> text_dark: #000000;
    in property <color> text_white_soft: #e2e8f0;
    in property <color> text_white_dim: #cbd5e1;

    // Swatch colors
    in property <color> swatch_cyan: #009eff;
    in property <color> swatch_green: #00ce88;
    in property <color> swatch_magenta: #ff007f;
    in property <color> swatch_purple: #7b1fa2;
    in property <color> swatch_red: #ff1744;
    in property <color> swatch_orange: #ff9100;
    in property <color> swatch_yellow: #ffd600;
    in property <color> swatch_white: #ffffff;

    // Radii
    in property <length> radius_xs: 2px;
    in property <length> radius_sm: 4px;
    in property <length> radius_md: 6px;
    in property <length> radius_base: 8px;
    in property <length> radius_lg: 12px;
    in property <length> radius_pill: 20px;
    in property <length> radius_round: 30px;

    // Typography
    in property <string> font_family: "Segoe UI";
    in property <length> font_xs: 9px;
    in property <length> font_sm: 10px;
    in property <length> font_caption: 11px;
    in property <length> font_body_sm: 12px;
    in property <length> font_body: 13px;
    in property <length> font_md: 14px;
    in property <length> font_lg: 16px;
    in property <length> font_title: 18px;
    in property <length> font_display: 24px;
}
