import { HubButton, HubMouse } from "ghub-controls.slint";
import { ReportRate } from "report-rate.slint";
import { AppSettings } from "app-settings.slint";
import { MemoryControls } from "memory-controls.slint";
import { KeyAssignmentEditor } from "key-assignment-editor.slint";
import { Slider, ScrollView, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    Card, Pill, IconButton, SidebarItem, Modal,
    MacroRow, StepRow, ProfileRow,
    SwatchButton, QuickKeyButton, QuickDelayButton
} from "components.slint";

export struct TabItem {
    id: int,
    title: string,
}

export struct ReleaseItem {
    tag: string,
    title: string,
    date: string,
    summary: string,
    url: string,
    prerelease: bool,
    latest: bool,
}

export struct SwatchItem {
    r: int,
    g: int,
    b: int,
    col: color,
}


export struct ProfileItem {
    id: string,
    name: string,
    description: string,
    dpi_info: string,
    keybinds_count: int,
    is_active: bool,
}

export struct QuickKeyItem {
    label: string,
    vk: int,
}

    export struct MacroItem {
        name: string,
        macro_type: string,
        is_toggle: bool,
        steps_count: int,
        is_custom: bool,
    }

    export struct KeybindItem {
        button_id: string,
        button_label: string,
        default_action: string,
        assigned_macro: string,
        assigned_label: string,
        is_mouse: bool,
    }

    export component MainWindow inherits Window {
        title: "Mouse Settings 502 · G502 HERO";
        icon: @image-url("assets/app-icon.png");
        min-width: 1200px;
        min-height: 700px;
        preferred-width: 1440px;
        preferred-height: 900px;
        background: Theme.app_bg;
        default-font-family: "Segoe UI";

        in property <[TabItem]> tabs: [
            { id: 1, title: "🎯  Чувствительность DPI" },
            { id: 4, title: "🎛️  Назначения" },
            { id: 2, title: "✨  Подсветка" },
        ];

        in property <[SwatchItem]> swatches: [
            { r: 0, g: 229, b: 255, col: Theme.swatch_cyan },
            { r: 0, g: 206, b: 136, col: Theme.swatch_green },
            { r: 255, g: 0, b: 127, col: Theme.swatch_magenta },
            { r: 123, g: 31, b: 162, col: Theme.swatch_purple },
            { r: 255, g: 23, b: 68, col: Theme.swatch_red },
            { r: 255, g: 145, b: 0, col: Theme.swatch_orange },
            { r: 255, g: 214, b: 0, col: Theme.swatch_yellow },
            { r: 255, g: 255, b: 255, col: Theme.swatch_white },
        ];

        in property <[QuickKeyItem]> quick_keys: [
            { label: "Space", vk: 32 },
            { label: "Ctrl", vk: 17 },
            { label: "Shift", vk: 16 },
            { label: "Alt", vk: 18 },
            { label: "Tab", vk: 9 },
            { label: "W", vk: 87 },
            { label: "A", vk: 65 },
            { label: "S", vk: 83 },
            { label: "D", vk: 68 },
            { label: "E", vk: 69 },
            { label: "R", vk: 82 },
            { label: "F", vk: 70 },
            { label: "C", vk: 67 },
            { label: "1", vk: 49 },
            { label: "2", vk: 50 },
            { label: "F1", vk: 112 },
        ];

        in property <[int]> quick_delays: [10, 25, 50, 100, 250];

        in-out property <int> active_tab: 0;
        in-out property <int> autostart_state: -1;
        in-out property <string> autostart_error: "";
        callback set_autostart(bool);
        callback refresh_autostart();
        in-out property <string> app_version: "1.0.0";
        in-out property <string> build_git_hash: "";
        in-out property <string> local_sha256: "";
        in-out property <int> update_status_kind: 0;
        in-out property <string> update_status_msg: "Нажмите «Проверить обновления», чтобы сравнить локальную сборку с GitHub Releases.";
        in-out property <string> remote_tag: "";
        in-out property <string> remote_sha256: "";
        in-out property <string> release_url: "";
        callback check_for_updates();
        callback open_releases_page();
        callback open_github_repo();
        in-out property <[ReleaseItem]> community_items: [];
        in-out property <bool> community_loading: false;
        in-out property <bool> community_loaded: false;
        in-out property <string> community_error: "";
        callback load_community(bool);
        callback open_community_release(string);
        in-out property <string> device_name: "Поиск мыши G502 HERO...";
        in-out property <bool> device_connected: false;
        in-out property <string> headset_name: "Logitech G435 Lightspeed";
        in-out property <bool> headset_connected: false;
        in-out property <int> current_dpi: 800;
        in-out property <[int]> report_rate_intervals: [];
        in-out property <int> report_rate_interval: 0;
        in-out property <bool> report_rate_busy: false;
        callback set_report_rate(int);
        in-out property <string> status_msg: "Готово к работе";
        in-out property <color> current_color: Theme.accent;
        in-out property <string> active_macro_name: "";
        in-out property <bool> listener_active: false;

        in-out property <[MacroItem]> macro_items: [];
        in-out property <[KeybindItem]> keybind_items: [];
        in-out property <[int]> dpi_presets: [400, 800, 1200, 1600, 2400, 3200, 6400];
        in-out property <string> custom_dpi_input: "";

        // Macro builder state
        in-out property <bool> show_macro_builder: false;
        in-out property <string> builder_editing_original: "";
        in-out property <string> builder_name: "Мой автокликер";
        in-out property <bool> builder_is_toggle: true;
        in-out property <[string]> builder_steps: [];
        in-out property <string> builder_custom_delay: "50";
        in-out property <string> builder_error: "";

        in-out property <int> builder_mode: 0;
        in-out property <int> builder_phase: 1;
        in-out property <[int]> builder_phase_counts: [0,0,0];
        in-out property <bool> builder_standard_delay: true;
        in-out property <string> builder_default_delay: "50";
        in-out property <string> builder_delay_input: "50";
        in-out property <string> builder_key_input: "A";
        in-out property <int> builder_selected_step: -1;
        in-out property <bool> builder_recording: false;
        in-out property <bool> builder_confirm_close: false;
        callback builder_set_phase(int);
        callback builder_refresh_timing();
        callback builder_add_chord(string, int);
        callback builder_insert_delay(string);
        callback builder_select_step(int);
        callback builder_update_delay(int, string);
        callback builder_toggle_recording();
        callback builder_capture_key(string, bool);
        callback builder_capture_mouse(int, bool);

        // Keybind picker modal
        in-out property <bool> show_bind_picker: false;
        in-out property <string> picker_button_id: "";
        in-out property <string> picker_button_name: "";

        // Profile state
        in-out property <string> active_profile_name: "Основной (Desktop)";
        in-out property <string> active_profile_id: "";
        in-out property <[ProfileItem]> profile_items: [];
        in-out property <bool> show_profile_creator: false;
        in-out property <string> new_profile_name: "";
        in-out property <string> new_profile_desc: "";
        in-out property <bool> g9_locked: true;
        in-out property <bool> onboard_enabled: false;
        in-out property <bool> onboard_known: false;
        in-out property <bool> onboard_busy: false;
        in-out property <bool> hardware_buttons_ready: false;
        in-out property <string> picker_error: "";
        callback set_memory_mode(bool);
        callback assign_keyboard(string, string);
        callback next_app_profile();
        in-out property <int> active_onboard_slot: 1;

        callback toggle_g9_lock();
        callback sync_all_onboard_memory();

        callback switch_profile(string);
        callback create_profile(string, string);
        callback duplicate_profile(string);
        callback delete_profile(string);

        callback set_dpi(int);
        callback apply_profile_dpi(string, string, int);
        callback refresh_profile_models();
        callback dpi_up();
        callback dpi_down();
        callback add_dpi_preset(int);
        callback remove_dpi_preset(int);
        callback apply_custom_dpi(string);
        callback apply_lighting(bool);
        callback toggle_macro(string);
        callback stop_all_macros();
        callback refresh_devices();

        // Macro builder callbacks
        callback open_macro_builder();
        callback edit_custom_macro(string);
        callback close_macro_builder();
        callback builder_add_mouse(int, bool, int);
        callback builder_add_key(int, bool, int);
        callback builder_add_delay(int);
        callback builder_clear_steps();
        callback builder_remove_step(int);
        callback builder_move_step_up(int);
        callback builder_move_step_down(int);
        callback builder_save_macro(string, string, bool);
        callback delete_custom_macro(string);

        // Keybinding callbacks
        callback toggle_listener();
        callback open_keybind_picker(string, string);
        callback close_keybind_picker();
        callback assign_keybind(string, string);
        callback clear_keybind(string);
        pure callback search_matches(string, string) -> bool;

        // Navigation uses the existing controller tab IDs.
        in-out property <int> assignment_view: 1;
        in-out property <int> assignment_category: 0;
        in-out property <string> assignment_search: "";
        in-out property <string> profile_search: "";
        in-out property <int> profile_filter: 0;
        in-out property <bool> profile_menu: false;
        in-out property <bool> grid_view: false;
        in-out property <int> lighting_effect: 0;
        in-out property <int> lighting_zone: 1;
        in-out property <int> lighting_r: 0;
        in-out property <int> lighting_g: 174;
        in-out property <int> lighting_b: 255;
        in-out property <float> effect_speed: 20;
        in-out property <float> effect_brightness: 100;
        property <int> cycle_step: 0;
        Timer {
            interval: root.effect_speed * 1000ms / 8;
            running: root.active_tab == 2 && root.lighting_effect == 0;
            triggered => { root.cycle_step = Math.mod(root.cycle_step + 1, root.swatches.length); }
        }
        property <int> breath_step: 0;
        Timer {
            interval: root.effect_speed * 1000ms / 40;
            running: root.active_tab == 2 && root.lighting_effect == 2;
            triggered => { root.breath_step = Math.mod(root.breath_step + 1, 40); }
        }
        property <bool> device_page: root.active_tab == 1 || root.active_tab == 2 || root.active_tab == 4;

        Rectangle {
            x: 0px; y: 0px; width: 100%; height: 88px;
            if root.active_tab == 0 || root.active_tab == 5 || root.active_tab == 6 || root.active_tab == 7 : Rectangle {
                x: 0px; y: 0px; width: 510px; height: 88px;
                HubButton { x: 24px; y: 25px; width: 58px; text: "app-logo"; font-size: 34px; clicked => { root.active_tab = 0; } }
                HubButton { x: 105px; y: 28px; width: 100px; text: "Устройства"; active: root.active_tab == 0; clicked => { root.active_tab = 0; } }
                HubButton { x: 220px; y: 28px; width: 110px; text: "Сообщество"; active: root.active_tab == 7; clicked => { root.active_tab = 7; root.load_community(false); } }
                HubButton { x: 345px; y: 28px; width: 85px; text: "Профили"; active: root.active_tab == 5; clicked => { root.active_tab = 5; } }
                Rectangle { x: root.active_tab == 5 ? 376px : root.active_tab == 7 ? 263px : 145px; y: 86px; width: 24px; height: 1px; background: Theme.accent; visible: root.active_tab != 6; }
            }
            if root.device_page || root.active_tab == 3 : Rectangle {
                x: 0px; y: 0px; width: 100%; height: 88px;
                HubButton { x: 13px; y: 27px; width: 46px; text: "←"; font-size: 30px; clicked => { root.active_tab = 0; } }
                Text { x: 80px; y: 28px; text: "G502 HERO"; font-size: 34px; font-weight: 700; color: white; }
            }
            HubButton {
                x: parent.width - 430px; y: 35px; width: 280px; height: 43px;
                background: #212224; text: "Рабочий стол: " + root.active_profile_name + "   ˅";
                clicked => { root.profile_menu = !root.profile_menu; }
            }
            HubButton { x: parent.width - 138px; y: 35px; width: 48px; height: 43px; text: "⚙"; font-size: 25px; clicked => { root.active_tab = 6; root.refresh_autostart(); } }
            Rectangle { x: parent.width - 69px; y: 44px; width: 28px; height: 28px; border-radius: 14px; background: #00afd1;
                Text { text: "●"; color: white; horizontal-alignment: center; vertical-alignment: center; font-size: 22px; }
            }
            Rectangle { y: 87px; width: 100%; height: 1px; background: root.device_page ? black : #303338; }
        }

        if root.active_tab == 0 : Rectangle {
            y: 88px; height: parent.height - 88px;
            HubButton { x: parent.width - 132px; y: 32px; width: 82px; height: 40px; text: root.grid_view ? "Список" : "Сетка"; active: true; background: #212224; clicked => { root.grid_view = !root.grid_view; } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: 96px;
                width: root.grid_view ? 340px : min(888px, parent.width - 160px);
                height: root.grid_view ? 365px : 150px;
                background: home-touch.has-hover ? #292a2c : #212224; border-radius: 13px;
                home-touch := TouchArea { mouse-cursor: pointer; clicked => { root.active_tab = 4; } }
                Image { source: @image-url("assets/mouse-top.svg"); x: root.grid_view ? 110px : 112px; y: 16px; width: root.grid_view ? 120px : 70px; height: root.grid_view ? 225px : 106px; image-fit: contain; }
                Text { x: root.grid_view ? 30px : 268px; y: root.grid_view ? 265px : 37px; text: "G502 HERO"; color: white; font-size: 25px; font-weight: 700; }
                Text { x: root.grid_view ? 30px : 270px; y: root.grid_view ? 305px : 87px; text: root.device_connected ? "Подключено" : "Не подключено"; color: #999b9d; font-size: 12px; }
                HubButton { x: parent.width - 129px; y: root.grid_view ? 305px : 51px; width: 48px; height: 48px; outlined: true; text: "☼"; font-size: 25px; clicked => { root.active_tab = 2; } }
                HubButton { x: parent.width - 73px; y: root.grid_view ? 305px : 51px; width: 48px; height: 48px; outlined: true; text: "▧"; font-size: 25px; clicked => { root.active_tab = 5; } }
            }
        }

        if root.device_page : Rectangle {
            y: 96px; height: parent.height - 114px;
            VerticalLayout {
                x: 14px; y: 20px; width: 48px; spacing: 5px; alignment: start;
                HubButton { height: 48px; text: "⌖"; font-size: 30px; filled: root.active_tab == 1; clicked => { root.active_tab = 1; } }
                HubButton { height: 48px; text: "⊞"; font-size: 30px; filled: root.active_tab == 4; clicked => { root.active_tab = 4; } }
                HubButton { height: 48px; text: "☼"; font-size: 30px; filled: root.active_tab == 2; clicked => { root.active_tab = 2; } }
            }
            HubButton { x: 14px; y: parent.height - 48px; width: 48px; height: 48px; outlined: true; text: "⚙"; font-size: 24px; clicked => { root.active_tab = 6; root.refresh_autostart(); } }
            panel := Rectangle {
                x: 76px; width: 310px; height: parent.height; border-radius: 13px; background: #212224;
                if root.active_tab == 4 : VerticalLayout {
                    padding: 16px; spacing: 14px;
                    Text { text: "Назначения"; color: white; font-size: 25px; height: 42px; }
                    HorizontalLayout { spacing: 12px; alignment: start;
                        HubButton { text: "КОМАНДЫ"; width: 90px; active: root.assignment_category == 0; clicked => { root.assignment_category = 0; } }
                        HubButton { text: "КЛАВИШИ"; width: 88px; active: root.assignment_category == 1; clicked => { root.assignment_category = 1; } }
                    }
                    HorizontalLayout { spacing: 4px;
                        HubButton { text: "ДЕЙСТВИЯ"; active: root.assignment_category == 2; clicked => { root.assignment_category = 2; } }
                        HubButton { text: "МАКРОСЫ"; active: root.assignment_category == 3; clicked => { root.assignment_category = 3; } }
                        HubButton { text: "СИСТЕМА"; active: root.assignment_category == 4; clicked => { root.assignment_category = 4; } }
                    }
                    Text { text: "Чтобы назначить команду, выберите кнопку на мыши."; color: white; font-size: 13px; wrap: word-wrap; }
                    LineEdit { text <=> root.assignment_search; placeholder-text: "Поиск назначений"; }
                    if root.assignment_category != 3 : ScrollView {
                        VerticalLayout { spacing: 0px;
                            Text { text: root.assignment_category == 1 ? "Клавиши мыши" : root.assignment_category == 4 ? "Системные команды" : "Назначения G502 HERO"; height: 38px; color: white; font-size: 14px; font-weight: 600; }
                            for item in root.keybind_items : Rectangle {
                                visible: root.assignment_search == "" || root.search_matches(item.button_label, root.assignment_search) || root.search_matches(item.assigned_label, root.assignment_search);
                                height: self.visible ? 48px : 0px;
                                background: binding-touch.has-hover ? #303133 : transparent;
                                HorizontalLayout { padding: 6px; spacing: 12px;
                                    Text { text: item.button_id; color: white; font-size: 13px; width: 38px; vertical-alignment: center; }
                                    Text { text: item.assigned_label == "" ? item.default_action : item.assigned_label; color: #a4a4a7; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: #3b3c3e; }
                                binding-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open_keybind_picker(item.button_id, item.button_label); } }
                            }
                        }
                    }
                    if root.assignment_category == 3 : ScrollView {
                        VerticalLayout { spacing: 8px;
                            HubButton { text: "+ СОЗДАТЬ МАКРОС"; filled: true; clicked => { root.open_macro_builder(); } }
                            for item in root.macro_items : HubButton { text: item.name; outlined: true; clicked => { root.edit_custom_macro(item.name); } }
                            HubButton { text: "Открыть студию макросов →"; clicked => { root.active_tab = 3; } }
                        }
                    }
                }
                if root.active_tab == 2 : VerticalLayout {
                    padding: 16px; spacing: 22px; alignment: start;
                    Text { text: "LIGHTSYNC"; color: white; font-size: 25px; height: 40px; }
                    Text { text: "☼  НАСТРОЙКИ ПОДСВЕТКИ"; color: Theme.accent; font-size: 14px; font-weight: 700; }
                    HorizontalLayout { spacing: 10px;
                        HubButton { text: "ОСНОВНАЯ"; active: root.lighting_zone == 0; clicked => { root.lighting_zone = 0; } }
                        HubButton { text: "ЛОГОТИП"; active: root.lighting_zone == 1; clicked => { root.lighting_zone = 1; } }
                    }
                    Text { text: "ЭФФЕКТ"; color: #adaeb2; font-size: 13px; }
                    ComboBox { model: ["Цикл", "Постоянный", "Дыхание", "Выключено"]; current-index <=> root.lighting_effect;
                        selected(value) => {
                            root.apply_lighting(false);
                        }
                    }
                    Text { text: "ЦВЕТ"; color: #adaeb2; font-size: 13px; }
                    HorizontalLayout { spacing: 7px;
                        for sw in root.swatches : Rectangle {
                            height: 24px; border-radius: 12px; background: sw.col;
                            border-width: root.current_color == sw.col ? 2px : 0px; border-color: white;
                            TouchArea { mouse-cursor: pointer; clicked => { if root.lighting_effect == 0 || root.lighting_effect == 3 { root.lighting_effect = 1; } root.current_color = sw.col; root.lighting_r = sw.r; root.lighting_g = sw.g; root.lighting_b = sw.b; root.apply_lighting(false); } }
                        }
                    }
                    Text { text: "ПЕРИОД ЭФФЕКТА"; color: #adaeb2; font-size: 13px; }
                    HorizontalLayout { Slider { minimum: 1; maximum: 20; value <=> root.effect_speed; changed => { root.apply_lighting(false); } } Text { text: Math.round(root.effect_speed * 1000) + " мс"; color: white; width: 70px; vertical-alignment: center; } }
                    Text { text: "ЯРКОСТЬ"; color: #adaeb2; font-size: 13px; }
                    HorizontalLayout { Slider { minimum: 1; maximum: 100; value <=> root.effect_brightness; changed => { root.apply_lighting(false); } } Text { text: Math.round(root.effect_brightness) + "%"; color: white; width: 50px; vertical-alignment: center; } }
                    HubButton { text: "СИНХРОНИЗИРОВАТЬ ЗОНЫ"; background: #393a3c; height: 50px; clicked => { root.apply_lighting(true); } }
                }
                if root.active_tab == 1 : VerticalLayout {
                    padding: 16px; spacing: 20px; alignment: start;
                    Text { text: "Чувствительность\n(DPI)"; color: white; font-size: 25px; }
                    Text { text: "DPI — это скорость курсора мыши на экране. Ее можно быстро менять с помощью кнопок DPI на мыши."; color: white; font-size: 13px; wrap: word-wrap; }
                    Text { text: "СКОРОСТИ DPI"; color: #adaeb2; font-size: 14px; }
                    HorizontalLayout { spacing: 5px;
                        for dpi in root.dpi_presets : HubButton { text: "" + dpi; active: root.current_dpi == dpi; font-size: 14px; clicked => { root.set_dpi(dpi); } }
                    }
                    Text { text: "Текущая скорость: " + root.current_dpi + " DPI.\nВыберите точку на шкале или укажите точное значение."; color: white; font-size: 13px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px;
                        LineEdit { text <=> root.custom_dpi_input; placeholder-text: "100–25600 DPI"; accepted => { root.apply_custom_dpi(root.custom_dpi_input); } }
                        HubButton { text: "OK"; width: 38px; outlined: true; clicked => { root.apply_custom_dpi(root.custom_dpi_input); } }
                    }
                    HubButton { text: "+  НАЗНАЧИТЬ ДЛЯ МЫШИ"; clicked => { root.active_tab = 4; } }
                    ReportRate { intervals: root.report_rate_intervals; current: root.report_rate_interval; busy: root.report_rate_busy; connected: root.device_connected; onboard: root.onboard_enabled; mode-known: root.onboard_known; select(interval) => { root.set_report_rate(interval); } }
                    HubButton { text: "+ СОХРАНИТЬ ТЕКУЩИЙ DPI"; outlined: true; clicked => { root.add_dpi_preset(root.current_dpi); } }
                }
            }
            canvas := Rectangle {
                x: 402px; width: parent.width - 418px; height: parent.height;
                if root.active_tab == 4 || root.active_tab == 2 : HubMouse {
                    y: root.active_tab == 2 ? 75px : 35px;
                    width: parent.width; height: parent.height - 100px;
                    side: root.active_tab == 4 && root.assignment_view == 2;
                    assignments: root.active_tab == 4;
                    glow: root.active_tab == 4 ? #686868 : root.lighting_effect == 3 ? #222222 : root.lighting_effect == 0 ? root.swatches[root.cycle_step].col : root.current_color;
                    light-level: root.active_tab != 2 ? 1 : root.lighting_effect == 3 ? 0 : root.effect_brightness / 100 * (root.lighting_effect == 2 ? Math.abs(root.breath_step - 20) / 20 : 1);
                    select(id,label) => { root.open_keybind_picker(id,label); }
                }
                if root.active_tab == 4 : Rectangle {
                    x: (parent.width - 300px) / 2; y: parent.height - 125px; width: 300px; height: 110px;
                    HorizontalLayout { y: 0px; height: 28px; spacing: 14px;
                        HubButton { text: "ПРОСМОТРЕТЬ 1"; outlined: true; active: root.assignment_view == 1; clicked => { root.assignment_view = 1; } }
                        HubButton { text: "ПРОСМОТРЕТЬ 2"; outlined: true; active: root.assignment_view == 2; clicked => { root.assignment_view = 2; } }
                    }
                    Text { y: 55px; width: 100%; text: "ПО УМОЛЧАНИЮ"; color: #ddd; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                }
                if root.active_tab == 2 : HubButton { x: (parent.width - 288px) / 2; y: parent.height - 110px; width: 288px; height: 48px; text: "ПАРАМЕТРЫ ПОДСВЕТКИ"; background: #393a3c; clicked => { root.active_tab = 6; root.refresh_autostart(); } }
                if root.active_tab == 1 : Rectangle {
                    Text { y: 18px; width: 100%; text: "СКОРОСТИ DPI"; color: white; font-size: 25px; horizontal-alignment: center; }
                    Text { y: 86px; width: 100%; text: "◆  СКОРОСТЬ ПЕРЕКЛЮЧЕНИЯ DPI"; color: #ffcc00; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                    Text { y: 128px; width: 100%; text: "Щелкните показатель скорости DPI, чтобы выбрать его.\nИспользуйте ползунок для точной настройки скорости."; color: white; font-size: 13px; horizontal-alignment: center; }
                    dpi-track := Rectangle {
                        x: 65px; y: parent.height * 0.46; width: parent.width - 130px; height: 100px;
                        Rectangle { y: 35px; height: 3px; width: 100%; background: #555557; }
                        for tick in 25 : Rectangle { x: parent.width * tick / 24; y: 31px; width: 1px; height: 10px; background: #88888a; }
                        for dpi in root.dpi_presets : Rectangle {
                            x: (parent.width - 28px) * (dpi <= 4000 ? (dpi - 100) / 3900 * 0.67 : 0.67 + (dpi - 4000) / 21600 * 0.33);
                            y: 0px; width: 28px; height: 60px;
                            Text { x: -24px; y: 0px; height: 20px; width: 76px; text: "" + dpi; color: root.current_dpi == dpi ? #ffcc00 : white; horizontal-alignment: center; font-size: 15px; font-weight: 700; }
                            Rectangle { x: 8px; y: 30px; width: 13px; height: 13px; border-radius: root.current_dpi == dpi ? 2px : 7px; background: root.current_dpi == dpi ? #ffcc00 : white; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.set_dpi(dpi); } }
                        }
                        Text { x: 0px; y: 70px; text: "100"; color: #aaa; font-size: 12px; }
                        Text { x: parent.width * 0.335; y: 70px; text: "2000"; color: #aaa; font-size: 12px; }
                        Text { x: parent.width * 0.67; y: 70px; text: "4000"; color: #aaa; font-size: 12px; }
                        Text { x: parent.width - 40px; y: 70px; text: "25600"; color: #aaa; font-size: 12px; }
                    }
                    Slider { x: 65px; y: parent.height * 0.46 + 115px; width: parent.width - 130px; minimum: 100; maximum: 25600; value: root.current_dpi; released => { root.set_dpi(Math.round(self.value / 50) * 50); } }
                    Text { y: parent.height * 0.68; x: 40px; width: parent.width - 80px; text: "Для быстрого изменения скорости назначьте переключение DPI кнопкам мыши."; color: #ffcc00; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                }
            }
        }

        if root.active_tab == 5 : Rectangle {
            y: 88px; height: parent.height - 88px;
            Rectangle { x: 0px; y: 0px; width: 337px; height: 100%; border-width: 1px; border-color: #303338;
                VerticalLayout { x: 48px; y: 34px; width: 269px; spacing: 0px; alignment: start;
                    HubButton { text: "Все                                      " + root.profile_items.length; active: root.profile_filter == 0; background: root.profile_filter == 0 ? #001e2c : transparent; clicked => { root.profile_filter = 0; } }
                    HubButton { text: "Активно"; active: root.profile_filter == 1; clicked => { root.profile_filter = 1; } }
                    HubButton { text: "Отключено"; active: root.profile_filter == 2; clicked => { root.profile_filter = 2; } }
                }
                VerticalLayout { x: 48px; y: parent.height - 210px; width: 269px; spacing: 14px; alignment: start;
                    Text { text: "Переключение профилей"; color: white; font-size: 16px; }
                    Text { text: "Текущий профиль"; color: #aaa; font-size: 13px; }
                    HubButton { text: root.active_profile_name + "  ˅"; background: #161719; clicked => { root.profile_menu = !root.profile_menu; } }
                    HubButton { text: "Следующий профиль →"; outlined: true; clicked => { root.next_app_profile(); } }
                }
            }
            Rectangle { x: 401px; y: 34px; width: parent.width - 453px; height: parent.height - 60px;
                Text { x: 0px; y: 0px; text: "Все игры и приложения"; color: white; font-size: 25px; font-weight: 600; }
                Text { x: 0px; y: 38px; width: parent.width - 560px; text: "Выберите профиль, чтобы управлять назначениями, макросами и настройками мыши."; color: #c5c5c8; font-size: 13px; wrap: word-wrap; }
                LineEdit { x: parent.width - 545px; y: 0px; width: 220px; height: 48px; text <=> root.profile_search; placeholder-text: "Поиск"; }
                HubButton { x: parent.width - 310px; y: 0px; width: 310px; height: 48px; text: "+  ДОБАВИТЬ ПРОФИЛЬ"; filled: true; clicked => { root.new_profile_name = ""; root.new_profile_desc = ""; root.show_profile_creator = true; } }
                ScrollView { y: 110px; height: parent.height - 260px;
                    VerticalLayout { spacing: 16px; alignment: start;
                        for item in root.profile_items : Rectangle {
                            visible: (root.profile_filter == 0 || (root.profile_filter == 1 && item.is_active) || (root.profile_filter == 2 && !item.is_active)) && (root.profile_search == "" || root.search_matches(item.name, root.profile_search));
                            height: self.visible ? 362px : 0px;
                            Rectangle { x: 0px; y: 0px; width: 192px; height: parent.height; border-radius: 13px; border-width: 1px; border-color: item.is_active ? Theme.accent : #404144; background: item.is_active ? #001624 : #151618;
                                Image { x: 12px; y: 12px; width: 168px; height: 220px; source: @image-url("assets/desktop-profile.svg"); image-fit: cover; }
                                Text { x: 12px; y: 250px; width: 168px; text: item.name; color: white; font-size: 14px; overflow: elide; }
                                Text { x: 12px; y: 300px; text: item.is_active ? "АКТИВНЫЙ" : "ВЫБРАТЬ"; color: Theme.accent; font-size: 11px; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.switch_profile(item.id); } }
                            }
                            VerticalLayout { x: 218px; y: 20px; width: 210px; spacing: 12px; alignment: start;
                                Text { text: item.description; color: #aaa; font-size: 13px; wrap: word-wrap; }
                                Text { text: item.dpi_info; color: #aaa; font-size: 13px; wrap: word-wrap; }
                                HubButton { text: "Дублировать"; outlined: true; clicked => { root.duplicate_profile(item.id); } }
                                HubButton { text: "Удалить"; outlined: true; clicked => { root.delete_profile(item.id); } }
                            }
                        }
                    }
                }
                MemoryControls { y: parent.height - 140px; height: 140px; connected: root.device_connected; known: root.onboard_known; busy: root.onboard_busy; onboard: root.onboard_enabled; g9-locked: root.g9_locked; buttons-ready: root.hardware_buttons_ready; slot: root.active_onboard_slot; change-mode(enabled) => { root.set_memory_mode(enabled); } toggle-g9 => { root.toggle_g9_lock(); } }
            }
        }

        if root.active_tab == 7 : Rectangle {
            x: 76px; y: 122px; width: parent.width - 128px; height: parent.height - 154px;
            VerticalLayout {
                spacing: 22px;
                HorizontalLayout { spacing: 24px;
                    VerticalLayout { spacing: 7px;
                        Text { text: "Сообщество"; color: white; font-size: 30px; font-weight: 700; }
                        Text { text: "Новости и последние обновления MouseSetting502"; color: #a4a7ac; font-size: 14px; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Версия приложения  " + root.app_version; color: #a4a7ac; font-size: 13px; vertical-alignment: center; }
                    HubButton { width: 140px; text: root.community_loading ? "Загрузка…" : "Обновить"; outlined: true; clicked => { root.load_community(true); } }
                    HubButton { width: 180px; text: "Репозиторий на GitHub"; outlined: true; clicked => { root.open_github_repo(); } }
                }
                Rectangle { height: 1px; background: #303338; }
                if root.community_loading : Text { text: "Получаем опубликованные заметки об обновлениях…"; color: Theme.accent; font-size: 13px; }
                if root.community_error != "" : Rectangle {
                    background: #2c2120; border-radius: 8px;
                    VerticalLayout { padding: 16px;
                        Text { text: root.community_error; color: #f4baaa; font-size: 13px; wrap: word-wrap; }
                    }
                }
                if root.community_loaded && !root.community_loading && root.community_items.length == 0 : Text {
                    text: "Пока нет опубликованных обновлений. Новые релизы появятся здесь после публикации на GitHub.";
                    color: #a4a7ac; font-size: 15px; wrap: word-wrap;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout { spacing: 18px; alignment: start;
                        for release in root.community_items : Rectangle {
                            background: #202224; border-radius: 12px; border-width: 1px;
                            border-color: release.latest ? #14577b : #34373b;
                            VerticalLayout { padding: 24px; spacing: 16px;
                                HorizontalLayout { spacing: 14px;
                                    Rectangle { width: 92px; height: 31px; border-radius: 6px; background: #07334d;
                                        Text { text: release.tag; color: #29b7ff; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: release.title; color: white; font-size: 21px; font-weight: 600; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if release.latest : Text { text: "ПОСЛЕДНИЙ РЕЛИЗ"; color: Theme.accent; font-size: 11px; vertical-alignment: center; }
                                    if release.prerelease : Text { text: "ТЕСТОВАЯ ВЕРСИЯ"; color: #dfbc65; font-size: 11px; vertical-alignment: center; }
                                    Text { text: release.date; color: #93979d; font-size: 13px; vertical-alignment: center; }
                                }
                                Text { text: release.summary; color: #c5c8cd; font-size: 14px; wrap: word-wrap; }
                                HorizontalLayout { spacing: 16px;
                                    Text { text: "Из заметок автора к обновлению"; color: #858a91; font-size: 12px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    HubButton { width: 180px; text: "Подробнее о релизе →"; outlined: true; clicked => { root.open_community_release(release.url); } }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.active_tab == 6 : AppSettings {
            x: 76px; y: 106px; width: parent.width - 110px; height: parent.height - 140px;
            startup-state: root.autostart_state; startup-error: root.autostart_error;
            set-startup(enabled) => { root.set_autostart(enabled); }
            refresh-startup => { root.refresh_autostart(); }
            app-version: root.app_version; build-git-hash: root.build_git_hash; local-sha256: root.local_sha256;
            update-status-kind: root.update_status_kind; update-status-msg: root.update_status_msg;
            remote-tag: root.remote_tag; remote-sha256: root.remote_sha256; release-url: root.release_url;
            check-update => { root.check_for_updates(); } open-releases => { root.open_releases_page(); } open-repository => { root.open_github_repo(); }
        }

        Text { x: 405px; y: parent.height - 22px; width: parent.width - 440px; height: 18px; text: root.status_msg; color: #747577; font-size: 11px; overflow: elide; }

        if root.profile_menu : Rectangle {
            x: parent.width - 430px; y: 82px; width: 280px; height: min(360px, root.profile_items.length * 44px + 56px); background: #252628; border-radius: 8px; border-width: 1px; border-color: #454648;
            VerticalLayout { padding: 8px; spacing: 4px;
                for item in root.profile_items : HubButton { text: item.name; active: item.is_active; clicked => { root.switch_profile(item.id); root.profile_menu = false; } }
                HubButton { text: "УПРАВЛЕНИЕ ПРОФИЛЯМИ →"; clicked => { root.active_tab = 5; root.profile_menu = false; } }
            }
        }

                        if root.active_tab == 3 : ScrollView {
 x: 76px; y: 108px; width: parent.width - 110px; height: parent.height - 145px;
                        VerticalLayout {
                            spacing: 14px;

                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Студия макросов & Автокликер";
                                        font-size: 20px;
                                        font-weight: 800;
                                        color: Theme.text_primary;
                                    }
                                    Text {
                                        text: "Создавайте и редактируйте автокликеры, последовательности с задержками и горячие комбинации.";
                                        font-size: 12px;
                                        color: Theme.text_secondary;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    Rectangle {
                                        height: 38px;
                                        border-radius: 6px;
                                        background: Theme.accent;
                                        HorizontalLayout {
                                            padding-left: 14px; padding-right: 14px;
                                            Text {
                                                text: "➕ СОЗДАТЬ МАКРОС";
                                                font-size: 12px;
                                                font-weight: 800;
                                                color: Theme.app_bg;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.open_macro_builder(); }
                                        }
                                    }

                                    if root.active_macro_name != "" : Rectangle {
                                        height: 38px;
                                        border-radius: 6px;
                                        background: Theme.swatch_red;
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px;
                                            Text {
                                                text: "⛔ ОСТАНОВИТЬ: " + root.active_macro_name;
                                                font-size: 11px;
                                                font-weight: 800;
                                                color: Theme.text_primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.stop_all_macros(); }
                                        }
                                    }
                                }
                            }

                            // Macros List
                            VerticalLayout {

                                VerticalLayout {
                                    spacing: 8px;

                                    for item in root.macro_items : MacroRow {
                                        name: item.name;
                                        macro_type: item.macro_type;
                                        is_toggle: item.is_toggle;
                                        steps_count: item.steps_count;
                                        is_custom: item.is_custom;
                                        is_active: root.active_macro_name == item.name;
                                        toggle => { root.toggle_macro(item.name); }
                                        edit => { root.edit_custom_macro(item.name); }
                                        delete => { root.delete_custom_macro(item.name); }
                                    }
                                }
                            }
                        }
                        }

                        // ==========================================
                        // TAB 4: KEYBINDS & BUTTON MAPPING (VISUAL G502)
                        // ==========================================

        // ==========================================
        // MODAL OVERLAY: MACRO CREATOR & EDITOR
        // ==========================================
        if root.show_macro_builder : Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%; background: #090a0c;
            TouchArea { }
            recorder := FocusScope {
                key-pressed(event) => {
                    if root.builder_recording {
                        if !event.repeat { root.builder_capture_key(event.text, true); }
                        accept
                    } else { reject }
                }
                key-released(event) => {
                    if root.builder_recording { root.builder_capture_key(event.text, false); accept } else { reject }
                }
            }
            VerticalLayout {
                padding: 32px; spacing: 18px;
                HorizontalLayout { spacing: 16px;
                    HubButton { text: "←"; width: 42px; font-size: 26px; clicked => { root.builder_confirm_close = true; } }
                    LineEdit { text <=> root.builder_name; placeholder-text: "Название макроса"; }
                    Text { text: root.builder_editing_original == "" ? "НОВЫЙ МАКРОС" : "РЕДАКТИРОВАНИЕ"; color: #92979d; font-size: 12px; vertical-alignment: center; }
                }
                HorizontalLayout { spacing: 12px;
                    for title[index] in ["→  Не повторять", "При удержании", "Переключение", "Последовательность"] : HubButton {
                        text: title; active: root.builder_mode == index; outlined: true; height: 48px;
                        clicked => { root.builder_set_phase(1); root.builder_mode = index; root.builder_is_toggle = index == 2; }
                    }
                }
                Text { text: root.builder_mode == 0 ? "Один полный проход после нажатия назначенной кнопки."
                    : root.builder_mode == 1 ? "Повторяется, пока назначенная кнопка зажата. Отпускание завершает повтор и освобождает клавиши."
                    : root.builder_mode == 2 ? "Первое нажатие запускает повтор; следующее нажатие его останавливает."
                    : "При нажатии → повтор при удержании → при отпускании. Каждый участок редактируется отдельно.";
                    color: #a6abb1; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout { spacing: 16px; alignment: start;
                    CheckBox { text: "Стандартная задержка между событиями"; checked <=> root.builder_standard_delay; toggled => { root.builder_refresh_timing(); } }
                    LineEdit { width: 90px; text <=> root.builder_default_delay; placeholder-text: "50"; edited => { root.builder_refresh_timing(); } }
                    Text { text: "мс"; color: white; vertical-alignment: center; }
                    Text { text: root.builder_standard_delay ? "Явные паузы сохраняются отдельно" : "Используются записанные и заданные паузы"; color: #92979d; vertical-alignment: center; font-size: 12px; }
                }
                if root.builder_mode == 3 : HorizontalLayout { spacing: 10px;
                    for title[index] in ["ПРИ НАЖАТИИ", "ПРИ УДЕРЖАНИИ", "ПРИ ОТПУСКАНИИ"] : HubButton {
                        text: title + "  ·  " + root.builder_phase_counts[index]; active: root.builder_phase == index; outlined: true;
                        clicked => { root.builder_set_phase(index); }
                    }
                }
                ScrollView {
                    vertical-stretch: 1; min-height: 150px;
                    HorizontalLayout { padding: 12px; spacing: 12px; alignment: start;
                        for step[index] in root.builder_steps : Rectangle {
                            width: 170px; height: 145px; border-radius: 9px; background: #202327;
                            border-width: 1px; border-color: root.builder_selected_step == index ? Theme.accent : #40454b;
                            Text { x: 14px; y: 12px; text: "" + (index + 1); color: #92979d; font-size: 11px; }
                            Text { x: 14px; y: 34px; width: parent.width - 28px; height: 92px; text: step; color: white; font-size: 15px; wrap: word-wrap; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.builder_select_step(index); } }
                        }
                        if root.builder_steps.length == 0 : Rectangle {
                            width: 500px; height: 145px; border-radius: 9px; border-width: 1px; border-color: #363b42;
                            Text { text: "Добавьте события ниже или начните запись.\nНажатие, отпускание и пауза — отдельные шаги."; color: #92979d; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; }
                        }
                    }
                }
                if root.builder_selected_step >= 0 : HorizontalLayout { spacing: 8px;
                    Text { text: "Шаг " + (root.builder_selected_step + 1); color: white; vertical-alignment: center; width: 90px; }
                    HubButton { text: "← Раньше"; outlined: true; clicked => { root.builder_move_step_up(root.builder_selected_step); } }
                    HubButton { text: "Позже →"; outlined: true; clicked => { root.builder_move_step_down(root.builder_selected_step); } }
                    HubButton { text: "Удалить шаг"; outlined: true; clicked => { root.builder_remove_step(root.builder_selected_step); } }
                    LineEdit { width: 95px; text <=> root.builder_delay_input; }
                    HubButton { text: "Пауза после / изменить, мс"; outlined: true; clicked => { root.builder_update_delay(root.builder_selected_step, root.builder_delay_input); } }
                }
                if !root.builder_recording : VerticalLayout { spacing: 10px;
                    HorizontalLayout { spacing: 8px;
                        Text { text: "МЫШЬ"; width: 80px; color: #92979d; font-size: 12px; vertical-alignment: center; }
                        for title[index] in ["ЛКМ", "ПКМ", "СКМ", "Назад", "Вперёд"] : HubButton {
                            text: "+ " + title; outlined: true;
                            clicked => { root.builder_add_mouse(index + 1, true, 0); root.builder_add_mouse(index + 1, false, 0); }
                        }
                        HubButton { text: "ЛКМ ↓"; outlined: true; clicked => { root.builder_add_mouse(1,true,0); } }
                        HubButton { text: "ЛКМ ↑"; outlined: true; clicked => { root.builder_add_mouse(1,false,0); } }
                    }
                    HorizontalLayout { spacing: 8px;
                        LineEdit { text <=> root.builder_key_input; placeholder-text: "A, Space, Ctrl+Shift+A…"; }
                        HubButton { text: "+ Сочетание"; outlined: true; clicked => { root.builder_add_chord(root.builder_key_input, 0); } }
                        HubButton { text: "↓ Нажать"; outlined: true; clicked => { root.builder_add_chord(root.builder_key_input, 1); } }
                        HubButton { text: "↑ Отпустить"; outlined: true; clicked => { root.builder_add_chord(root.builder_key_input, 2); } }
                        LineEdit { width: 100px; text <=> root.builder_delay_input; placeholder-text: "50"; }
                        HubButton { text: "+ Пауза, мс"; outlined: true; clicked => { root.builder_insert_delay(root.builder_delay_input); } }
                    }
                }
                if root.builder_recording : Rectangle {
                    height: 95px; background: #271b22; border-radius: 8px; border-width: 1px; border-color: #ed3a68;
                    Text { text: "ЗАПИСЬ · Нажимайте клавиши; кликайте в этой зоне для записи мыши.\nEsc или «Остановить запись» завершает запись. Запись действует внутри этого окна."; color: white; horizontal-alignment: center; vertical-alignment: center; font-size: 13px; }
                    TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down || event.kind == PointerEventKind.up {
                                root.builder_capture_mouse(event.button == PointerEventButton.left ? 1 : event.button == PointerEventButton.right ? 2 : event.button == PointerEventButton.middle ? 3 : event.button == PointerEventButton.back ? 4 : event.button == PointerEventButton.forward ? 5 : 0, event.kind == PointerEventKind.down);
                            }
                        }
                        clicked => { recorder.focus(); }
                    }
                }
                Text { visible: root.builder_error != ""; text: root.builder_error; color: #ff8ca5; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout { spacing: 12px;
                    HubButton { text: root.builder_recording ? "■ Остановить запись" : "● Начать запись"; outlined: true; clicked => { root.builder_toggle_recording(); if root.builder_recording { recorder.focus(); } } }
                    HubButton { text: "Очистить участок"; outlined: true; clicked => { root.builder_clear_steps(); } }
                    Rectangle { horizontal-stretch: 1; }
                    HubButton { text: "Отмена"; width: 110px; clicked => { root.builder_confirm_close = true; } }
                    HubButton { text: "СОХРАНИТЬ"; width: 200px; filled: true; clicked => { root.builder_save_macro(root.builder_editing_original, root.builder_name, root.builder_mode == 2); } }
                }
            }
            if root.builder_confirm_close : Rectangle {
                width: 100%; height: 100%; background: #000000cc; TouchArea { }
                Rectangle { width: 430px; height: 180px; background: #23262b; border-radius: 12px;
                    VerticalLayout { padding: 24px; spacing: 20px;
                        Text { text: "Закрыть редактор без сохранения?"; color: white; font-size: 18px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 12px;
                            HubButton { text: "Продолжить"; outlined: true; clicked => { root.builder_confirm_close = false; } }
                            HubButton { text: "Не сохранять"; outlined: true; clicked => { root.builder_confirm_close = false; root.close_macro_builder(); } }
                        }
                    }
                }
            }
        }

        // ==========================================
        // MODAL OVERLAY: KEYBIND PICKER
        // ==========================================
        if root.show_bind_picker : Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay;

            TouchArea { /* block clicks outside modal */ }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 540px;
                        height: 580px;
                        border-radius: 12px;
                        background: Theme.card_bg_subtle;
                        border-width: 1px;
                        border-color: Theme.border_default;

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    // Header
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Назначение кнопки";
                                font-size: 16px;
                                font-weight: 800;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Кнопка: " + root.picker_button_name + " [" + root.picker_button_id + "]";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.accent;
                            }
                        }
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 6px; background: Theme.surface_elevated;
                            Text { text: "✕"; font-size: 12px; font-weight: 800; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show_bind_picker = false;
                                    root.close_keybind_picker();
                                }
                            }
                        }
                    }

                    KeyAssignmentEditor {
                        error: root.picker_error;
                        assign(chord) => { root.assign_keyboard(root.picker_button_id, chord); }
                    }

                    // Reset to default button
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: Theme.error_subtle;
                        border-width: 1px;
                        border-color: Theme.error_border;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; alignment: center;
                            Text {
                                text: "✕ Сбросить на стандартное действие мыши";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.error_bright;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.clear_keybind(root.picker_button_id);
                            }
                        }
                    }

                    Text {
                        text: "Действия сенсора (переключение DPI):";
                        font-size: Theme.font_caption;
                        font-weight: 700;
                        color: Theme.text_secondary;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 38px;
                            border-radius: Theme.radius_md;
                            background: Theme.surface_alt;
                            border-width: 1px;
                            border-color: Theme.border_btn;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text { text: "◀"; font-size: Theme.font_caption; color: Theme.accent; vertical-alignment: center; }
                                Text { text: "DPI ВНИЗ (Пресет)"; font-size: Theme.font_caption; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.assign_keybind(root.picker_button_id, "__DPI_DOWN__");
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 38px;
                            border-radius: Theme.radius_md;
                            background: Theme.surface_alt;
                            border-width: 1px;
                            border-color: Theme.border_btn;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text { text: "DPI ВВЕРХ (Пресет)"; font-size: Theme.font_caption; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; }
                                Text { text: "▶"; font-size: Theme.font_caption; color: Theme.accent; vertical-alignment: center; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.assign_keybind(root.picker_button_id, "__DPI_UP__");
                                }
                            }
                        }
                    }

                    Text {
                        text: "Выберите макрос из списка доступных:";
                        font-size: Theme.font_caption;
                        font-weight: 700;
                        color: Theme.text_secondary;
                    }

                    // Available macros list
                    ScrollView {
                        vertical-stretch: 1;
                        min-height: 0px;
                        VerticalLayout {
                            spacing: 6px;

                            for m in root.macro_items : Rectangle {
                                height: 44px;
                                border-radius: 6px;
                                background: row-touch.has-hover ? Theme.surface_elevated : Theme.surface;
                                border-width: 1px;
                                border-color: row-touch.has-hover ? Theme.accent : Theme.border_card;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: m.is_toggle ? "🔄" : "⚡"; font-size: 14px; vertical-alignment: center; }
                                        Text { text: m.name; font-size: 13px; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; }
                                    }

                                    Rectangle {
                                        height: 26px; border-radius: 4px; background: Theme.accent;
                                        HorizontalLayout {
                                            padding-left: 10px; padding-right: 10px;
                                            Text { text: "Выбрать"; font-size: 11px; font-weight: 800; color: Theme.app_bg; vertical-alignment: center; }
                                        }
                                    }
                                }
                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.assign_keybind(root.picker_button_id, m.name);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
            }
            }
    
        // ==========================================
        // MODAL OVERLAY: PROFILE CREATOR
        // ==========================================
        if root.show_profile_creator : Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay;

            TouchArea { /* block clicks outside */ }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 500px;
                        height: 290px;
                        border-radius: 12px;
                        background: Theme.card_bg_subtle;
                        border-width: 1px;
                        border-color: Theme.border_default;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Создать новый профиль";
                                    font-size: 16px;
                                    font-weight: 800;
                                    color: Theme.text_primary;
                                }
                                Rectangle {
                                    width: 28px; height: 28px; border-radius: 6px; background: Theme.surface_elevated;
                                    Text { text: "✕"; font-size: 12px; font-weight: 800; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.show_profile_creator = false; }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Название профиля:"; font-size: 11px; font-weight: 700; color: Theme.text_white_dim; }
                                LineEdit {
                                    text: root.new_profile_name;
                                    edited(val) => { root.new_profile_name = val; }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Описание (игры / назначение):"; font-size: 11px; font-weight: 700; color: Theme.text_white_dim; }
                                LineEdit {
                                    text: root.new_profile_desc;
                                    edited(val) => { root.new_profile_desc = val; }
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 10px;

                                Rectangle {
                                    height: 36px; border-radius: 6px; background: Theme.surface_elevated;
                                    HorizontalLayout { padding-left: 14px; padding-right: 14px; Text { text: "Отмена"; font-size: 12px; font-weight: 700; color: Theme.text_secondary; vertical-alignment: center; } }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.show_profile_creator = false; }
                                    }
                                }

                                Rectangle {
                                    height: 36px; border-radius: 6px; background: Theme.accent;
                                    HorizontalLayout { padding-left: 16px; padding-right: 16px; Text { text: "СОЗДАТЬ"; font-size: 12px; font-weight: 800; color: Theme.app_bg; vertical-alignment: center; } }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.create_profile(root.new_profile_name, root.new_profile_desc);
                                            root.show_profile_creator = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

}
