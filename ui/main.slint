    import { Slider, ScrollView, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    Card, Pill, IconButton, SidebarItem, Modal,
    MacroRow, StepRow, KeybindRow,
    SwatchButton, QuickKeyButton, QuickDelayButton
} from "components.slint";

export struct TabItem {
    id: int,
    title: string,
}

export struct SwatchItem {
    r: int,
    g: int,
    b: int,
    col: color,
}

export struct QuickKeyItem {
    label: string,
    vk: int,
}

    export struct MacroItem {
        name: string,
        macro_type: string,
        is_toggle: bool,
        steps_count: int,
        is_custom: bool,
    }

    export struct KeybindItem {
        button_id: string,
        button_label: string,
        default_action: string,
        assigned_macro: string,
        is_mouse: bool,
    }

    export component MainWindow inherits Window {
        title: "Logitech G HUB (Rust Edition)";
        min-width: 1040px;
        min-height: 700px;
        preferred-width: 1080px;
        preferred-height: 740px;
        background: Theme.app_bg;
        default-font-family: "Segoe UI";

        in property <[TabItem]> tabs: [
            { id: 0, title: "🖥️  Обзор устройств" },
            { id: 1, title: "🎯  Сенсор & DPI" },
            { id: 2, title: "✨  Подсветка LIGHTSYNC" },
            { id: 3, title: "⚡  Студия макросов" },
            { id: 4, title: "🎛️  Назначение клавиш" },
        ];

        in property <[SwatchItem]> swatches: [
            { r: 0, g: 229, b: 255, col: Theme.swatch_cyan },
            { r: 0, g: 206, b: 136, col: Theme.swatch_green },
            { r: 255, g: 0, b: 127, col: Theme.swatch_magenta },
            { r: 123, g: 31, b: 162, col: Theme.swatch_purple },
            { r: 255, g: 23, b: 68, col: Theme.swatch_red },
            { r: 255, g: 145, b: 0, col: Theme.swatch_orange },
            { r: 255, g: 214, b: 0, col: Theme.swatch_yellow },
            { r: 255, g: 255, b: 255, col: Theme.swatch_white },
        ];

        in property <[QuickKeyItem]> quick_keys: [
            { label: "Space", vk: 32 },
            { label: "Ctrl", vk: 17 },
            { label: "Shift", vk: 16 },
            { label: "Alt", vk: 18 },
            { label: "Tab", vk: 9 },
            { label: "W", vk: 87 },
            { label: "A", vk: 65 },
            { label: "S", vk: 83 },
            { label: "D", vk: 68 },
            { label: "E", vk: 69 },
            { label: "R", vk: 82 },
            { label: "F", vk: 70 },
            { label: "C", vk: 67 },
            { label: "1", vk: 49 },
            { label: "2", vk: 50 },
            { label: "F1", vk: 112 },
        ];

        in property <[int]> quick_delays: [10, 25, 50, 100, 250];

        in-out property <int> active_tab: 0;
        in-out property <string> device_name: "Поиск мыши G502 HERO...";
        in-out property <bool> device_connected: false;
        in-out property <string> headset_name: "Logitech G435 Lightspeed";
        in-out property <bool> headset_connected: false;
        in-out property <int> current_dpi: 800;
        in-out property <string> status_msg: "Готово к работе";
        in-out property <color> current_color: Theme.accent;
        in-out property <string> active_macro_name: "";
        in-out property <bool> listener_active: false;

        in-out property <[MacroItem]> macro_items: [];
        in-out property <[KeybindItem]> keybind_items: [];
        in-out property <[int]> dpi_presets: [400, 800, 1200, 1600, 2400, 3200, 6400];
        in-out property <string> custom_dpi_input: "";

        // Macro builder state
        in-out property <bool> show_macro_builder: false;
        in-out property <string> builder_editing_original: "";
        in-out property <string> builder_name: "Мой автокликер";
        in-out property <bool> builder_is_toggle: true;
        in-out property <[string]> builder_steps: [];
        in-out property <string> builder_custom_delay: "50";

        // Keybind picker modal
        in-out property <bool> show_bind_picker: false;
        in-out property <string> picker_button_id: "";
        in-out property <string> picker_button_name: "";

        callback set_dpi(int);
        callback dpi_up();
        callback dpi_down();
        callback add_dpi_preset(int);
        callback remove_dpi_preset(int);
        callback apply_custom_dpi(string);
        callback set_rgb_static(int, int, int);
        callback set_rgb_cycle();
        callback set_rgb_breathe(int, int, int);
        callback set_rgb_off();
        callback toggle_macro(string);
        callback stop_all_macros();
        callback refresh_devices();

        // Macro builder callbacks
        callback open_macro_builder();
        callback edit_custom_macro(string);
        callback close_macro_builder();
        callback builder_add_mouse(int, bool, int);
        callback builder_add_key(int, bool, int);
        callback builder_add_delay(int);
        callback builder_clear_steps();
        callback builder_remove_step(int);
        callback builder_move_step_up(int);
        callback builder_move_step_down(int);
        callback builder_save_macro(string, string, bool);
        callback delete_custom_macro(string);

        // Keybinding callbacks
        callback toggle_listener();
        callback open_keybind_picker(string, string);
        callback close_keybind_picker();
        callback assign_keybind(string, string);
        callback clear_keybind(string);

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // ==========================================
            // HEADER BAR
            // ==========================================
            Rectangle {
                height: 64px;
                background: Theme.header_bg;
                border-width: 0px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    // Brand / Logo
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: center;

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 8px;
                            background: Theme.accent_subtle;
                            border-width: 1px;
                            border-color: Theme.accent_border;

                            Text {
                                text: "⯛ G";
                                font-size: 16px;
                                font-weight: 900;
                                color: Theme.accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "LOGITECH G";
                                    font-size: 16px;
                                    font-weight: 800;
                                    color: Theme.text_heading;
                                }
                                Text {
                                    text: "PRO EDITION";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "LIGHTSPEED NATIVE WORKER • DIRECT HID++ 2.0 • ZERO-LATENCY";
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.text_muted;
                            }
                        }
                    }

                    // Device Status Indicators & Metrics
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        // Mouse status pill
                        Pill {
                            text: root.device_connected ? root.device_name : "Мышь не обнаружена";
                            text_color: root.device_connected ? Theme.text_heading : Theme.error_text;
                            bg_col: root.device_connected ? Theme.success_bg : Theme.error_subtle;
                            border_col: root.device_connected ? Theme.success : Theme.error;
                            dot_color: root.device_connected ? Theme.success_dot : Theme.error;
                            show_dot: true;
                        }

                        // Headset status pill
                        Pill {
                            text: root.headset_connected ? "🎧 G435: Подключен" : "🎧 G435: Беспроводной";
                            text_color: root.headset_connected ? Theme.accent : Theme.text_inactive;
                            bg_col: root.headset_connected ? Theme.headset_bg_connected : Theme.headset_bg_disconnected;
                            border_col: root.headset_connected ? Theme.accent : Theme.headset_border_disconnected;
                        }

                        // Refresh button
                        IconButton {
                            icon: "🔄";
                            icon_size: 13px;
                            clicked => { root.refresh_devices(); }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            // ==========================================
            // MAIN BODY: SIDEBAR + CONTENT AREA
            // ==========================================
            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // --- Modern Sidebar Navigation ---
                Rectangle {
                    width: 235px;
                    background: Theme.header_bg;

                    VerticalLayout {
                        padding-top: 18px;
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 18px;
                        spacing: 6px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 6px;

                            for tab in root.tabs : SidebarItem {
                                title: tab.title;
                                active: root.active_tab == tab.id;
                                clicked => { root.active_tab = tab.id; }
                            }
                        }

                        // Bottom sidebar quick summary
                        Rectangle {
                            height: 112px;
                            border-radius: 8px;
                            background: Theme.card_bg;
                            border-width: 1px;
                            border-color: Theme.border_default;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 5px;

                                Text {
                                    text: "СИСТЕМНЫЙ СТАТУС";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: Theme.text_muted;
                                }

                                Text {
                                    text: "Сенсор: HERO 25K • " + root.current_dpi + " DPI";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.text_white_dim;
                                }

                                Text {
                                    text: root.active_macro_name != "" ? ("🟢 Макрос: " + root.active_macro_name) : "⚪ Макрос: Остановлен";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.active_macro_name != "" ? Theme.accent : Theme.text_subtle;
                                }

                                Text {
                                    text: root.listener_active ? "🟢 Low-Level Hook: Активен" : "⚪ Hook: Отключен";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.listener_active ? Theme.success : Theme.text_subtle;
                                }
                            }
                        }
                    }
                }

                // Vertical Divider
                Rectangle {
                    width: 1px;
                    background: Theme.divider;
                }

                // --- Content Canvas ---
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.app_bg;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        // ==========================================
                        // TAB 0: DEVICE OVERVIEW
                        // ==========================================
                        if root.active_tab == 0 : ScrollView {
                        VerticalLayout {
                            spacing: 16px;

                            Text {
                                text: "Обзор подключенных устройств";
                                font-size: 20px;
                                font-weight: 800;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Аппаратный контроль Logitech HID++ 2.0 без фонового Electron и сбора телеметрии.";
                                font-size: 13px;
                                color: Theme.text_secondary;
                            }

                            // Card 1: G502 HERO
                            Rectangle {
                                height: 160px;
                                border-radius: 10px;
                                background: Theme.card_bg_subtle;
                                border-width: 1px;
                                border-color: root.device_connected ? Theme.border_card : Theme.error_subtle;

                                HorizontalLayout {
                                    padding: 20px;
                                    spacing: 20px;

                                    Rectangle {
                                        width: 120px;
                                        height: 120px;
                                        border-radius: 8px;
                                        background: Theme.surface_alt;
                                        border-width: 1px;
                                        border-color: Theme.border_card;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text {
                                                text: "🖱️";
                                                font-size: 38px;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: "G502 HERO";
                                                font-size: 11px;
                                                font-weight: 800;
                                                color: Theme.accent;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 12px;
                                            Text {
                                                text: root.device_name;
                                                font-size: 17px;
                                                font-weight: 800;
                                                color: Theme.text_primary;
                                            }
                                            Rectangle {
                                                height: 22px;
                                                border-radius: 4px;
                                                background: root.device_connected ? Theme.success_bg : Theme.error_subtle;
                                                HorizontalLayout {
                                                    padding-left: 8px; padding-right: 8px;
                                                    Text {
                                                        text: root.device_connected ? "HERO 25K READY" : "ОФФЛАЙН";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        color: root.device_connected ? Theme.success_dot : Theme.error_bright;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: "• Оптический сенсор HERO 25K (100 - 25 600 DPI, шаг 50)\n• Частота опроса: 1000 Гц (1 мс) • Host Mode включен\n• 11 программируемых клавиш • LIGHTSYNC RGB подсветка";
                                            font-size: 12px;
                                            color: Theme.text_secondary;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Rectangle {
                                                width: 140px; height: 32px; border-radius: 6px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                                HorizontalLayout { alignment: center; Text { text: "🎯 Настроить DPI"; font-size: 12px; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; } }
                                                TouchArea { clicked => { root.active_tab = 1; } }
                                            }
                                            Rectangle {
                                                width: 160px; height: 32px; border-radius: 6px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                                HorizontalLayout { alignment: center; Text { text: "🎛️ Назначить клавиши"; font-size: 12px; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; } }
                                                TouchArea { clicked => { root.active_tab = 4; } }
                                            }
                                        }
                                    }
                                }
                            }

                            // Card 2: G435 Lightspeed Headset
                            Rectangle {
                                height: 130px;
                                border-radius: 10px;
                                background: Theme.card_bg_subtle;
                                border-width: 1px;
                                border-color: Theme.border_card;

                                HorizontalLayout {
                                    padding: 20px;
                                    spacing: 20px;

                                    Rectangle {
                                        width: 90px;
                                        height: 90px;
                                        border-radius: 8px;
                                        background: Theme.surface_alt;
                                        border-width: 1px;
                                        border-color: Theme.border_card;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text {
                                                text: "🎧";
                                                font-size: 32px;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: "G435";
                                                font-size: 11px;
                                                font-weight: 800;
                                                color: Theme.success;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 6px;

                                        HorizontalLayout {
                                            spacing: 12px;
                                            Text {
                                                text: root.headset_name;
                                                font-size: 16px;
                                                font-weight: 800;
                                                color: Theme.text_primary;
                                            }
                                            Rectangle {
                                                height: 22px;
                                                border-radius: 4px;
                                                background: Theme.surface_alt;
                                                HorizontalLayout {
                                                    padding-left: 8px; padding-right: 8px;
                                                    Text {
                                                        text: "LIGHTSPEED WIRELESS";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        color: Theme.accent;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: "• 40 мм аудиодрайверы с поддержкой Dolby Atmos\n• Двойные микрофоны с формированием луча (beamforming)\n• Ультралегкая конструкция: 165 г";
                                            font-size: 12px;
                                            color: Theme.text_secondary;
                                        }
                                    }
                                }
                            }
                        }
                        }

                        // ==========================================
                        // TAB 1: SENSOR & DPI
                        // ==========================================
                        if root.active_tab == 1 : ScrollView {
                        VerticalLayout {
                            spacing: 18px;

                            Text {
                                text: "Настройка сенсора HERO 25K";
                                font-size: Theme.font_title;
                                font-weight: 800;
                                color: Theme.text_primary;
                            }

                            // Big DPI Card with Quick Buttons
                            Rectangle {
                                height: 140px;
                                border-radius: Theme.radius_md;
                                background: Theme.card_bg_subtle;
                                border-width: 1px;
                                border-color: Theme.border_subtle;

                                HorizontalLayout {
                                    padding: 20px;
                                    alignment: space-between;

                                    // Button: DPI Down (Previous Preset)
                                    Rectangle {
                                        width: 160px;
                                        height: 48px;
                                        border-radius: Theme.radius_base;
                                        background: Theme.surface_alt;
                                        border-width: 1px;
                                        border-color: Theme.border_btn;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Text { text: "◀"; font-size: Theme.font_caption; color: Theme.accent; vertical-alignment: center; }
                                            Text { text: "DPI ВНИЗ (G7)"; font-size: Theme.font_caption; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.dpi_down(); } }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Text {
                                            text: "ТЕКУЩЕЕ РАЗРЕШЕНИЕ СЕНСОРА";
                                            font-size: Theme.font_xs;
                                            font-weight: 800;
                                            color: Theme.text_subtle;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: root.current_dpi + " DPI";
                                            font-size: 42px;
                                            font-weight: 900;
                                            color: Theme.accent;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "HERO 25K • Нулевое сглаживание, аппаратная точность 1:1";
                                            font-size: Theme.font_caption;
                                            color: Theme.text_muted;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // Button: DPI Up (Next Preset)
                                    Rectangle {
                                        width: 160px;
                                        height: 48px;
                                        border-radius: Theme.radius_base;
                                        background: Theme.surface_alt;
                                        border-width: 1px;
                                        border-color: Theme.border_btn;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            Text { text: "DPI ВВЕРХ (G8)"; font-size: Theme.font_caption; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; }
                                            Text { text: "▶"; font-size: Theme.font_caption; color: Theme.accent; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.dpi_up(); } }
                                    }
                                }
                            }

                            // Dynamic Configurable Presets
                            VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Настраиваемые пресеты чувствительности (переключение по кнопкам G7/G8):";
                                    font-size: Theme.font_body;
                                    font-weight: 700;
                                    color: Theme.text_white_dim;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    for dpi[idx] in root.dpi_presets : Rectangle {
                                        height: 42px;
                                        border-radius: Theme.radius_base;
                                        background: root.current_dpi == dpi ? Theme.accent : Theme.surface_alt;
                                        border-width: 1px;
                                        border-color: root.current_dpi == dpi ? Theme.accent : Theme.border_btn;

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: center;

                                            Text {
                                                text: dpi + " DPI";
                                                font-size: Theme.font_body;
                                                font-weight: 800;
                                                color: root.current_dpi == dpi ? Theme.app_bg : Theme.text_white_soft;
                                                vertical-alignment: center;
                                            }

                                            // Remove preset button (if more than 1)
                                            if root.dpi_presets.length > 1 : Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                border-radius: Theme.radius_xs;
                                                background: root.current_dpi == dpi ? Theme.app_bg : Theme.surface_elevated;

                                                Text {
                                                    text: "✕";
                                                    font-size: 10px;
                                                    font-weight: 800;
                                                    color: root.current_dpi == dpi ? Theme.accent : Theme.text_subtle;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => { root.remove_dpi_preset(dpi); }
                                                }
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.set_dpi(dpi); }
                                        }
                                    }
                                }
                            }

                            // Custom DPI Input Section
                            Rectangle {
                                border-radius: Theme.radius_md;
                                background: Theme.card_bg_subtle;
                                border-width: 1px;
                                border-color: Theme.border_card;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 12px;

                                    Text {
                                        text: "Кастомный DPI (произвольное значение):";
                                        font-size: Theme.font_body;
                                        font-weight: 700;
                                        color: Theme.text_white_dim;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;

                                        custom_dpi_input := LineEdit {
                                            width: 180px;
                                            height: 40px;
                                            placeholder-text: "Например: 1350";
                                            text <=> root.custom_dpi_input;
                                            accepted => {
                                                root.apply_custom_dpi(self.text);
                                            }
                                        }

                                        // Apply Custom DPI Button
                                        Rectangle {
                                            height: 40px;
                                            border-radius: Theme.radius_base;
                                            background: Theme.accent;

                                            HorizontalLayout {
                                                padding-left: 18px;
                                                padding-right: 18px;
                                                alignment: center;
                                                Text {
                                                    text: "Установить DPI";
                                                    font-size: Theme.font_body_sm;
                                                    font-weight: 800;
                                                    color: Theme.app_bg;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.apply_custom_dpi(custom_dpi_input.text);
                                                }
                                            }
                                        }

                                        // Add to presets button
                                        Rectangle {
                                            height: 40px;
                                            border-radius: Theme.radius_base;
                                            background: Theme.surface_alt;
                                            border-width: 1px;
                                            border-color: Theme.border_btn;

                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                alignment: center;
                                                Text {
                                                    text: "➕ Добавить в пресеты";
                                                    font-size: Theme.font_body_sm;
                                                    font-weight: 700;
                                                    color: Theme.text_primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.add_dpi_preset(custom_dpi_input.text.to-float());
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Slider fine control
                            VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Плавная регулировка (100 - 25600 DPI, шаг 50):";
                                        font-size: Theme.font_caption;
                                        color: Theme.text_secondary;
                                    }
                                    Text {
                                        text: root.current_dpi + " DPI";
                                        font-size: Theme.font_caption;
                                        font-weight: 700;
                                        color: Theme.accent;
                                    }
                                }
                                Slider {
                                    minimum: 100;
                                    maximum: 25600;
                                    value: root.current_dpi;
                                    changed(v) => {
                                        root.current_dpi = Math.round(v / 50) * 50;
                                    }
                                    released(v) => {
                                        root.set_dpi(root.current_dpi);
                                    }
                                }
                            }
                        }
                        }

                        // ==========================================
                        // TAB 2: RGB LIGHTSYNC
                        // ==========================================
                        if root.active_tab == 2 : ScrollView {
                        VerticalLayout {
                            spacing: 18px;

                            Text {
                                text: "Управление подсветкой LIGHTSYNC RGB";
                                font-size: 20px;
                                font-weight: 800;
                                color: Theme.text_primary;
                            }

                            // Glowing Preview Card
                            Rectangle {
                                height: 110px;
                                border-radius: 10px;
                                background: Theme.card_bg_subtle;
                                border-width: 1px;
                                border-color: Theme.border_subtle;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 20px;

                                    Rectangle {
                                        width: 60px;
                                        height: 60px;
                                        border-radius: 30px;
                                        background: root.current_color;
                                        border-width: 3px;
                                        border-color: Theme.swatch_border_unselected;

                                        Text {
                                            text: "G";
                                            font-size: 26px;
                                            font-weight: 900;
                                            color: Theme.text_primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "Активная зона: Логотип Logitech G";
                                            font-size: 16px;
                                            font-weight: 800;
                                            color: Theme.text_primary;
                                        }
                                        Text {
                                            text: "16.8 миллионов оттенков • Аппаратное сохранение в память мыши";
                                            font-size: 12px;
                                            color: Theme.text_secondary;
                                        }
                                    }
                                }
                            }

                            // Swatches
                            Text {
                                text: "Быстрая палитра Logitech G:";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text_white_dim;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                for s in root.swatches : SwatchButton {
                                    swatch_color: s.col;
                                    is_selected: root.current_color == s.col;
                                    clicked => {
                                        root.current_color = s.col;
                                        root.set_rgb_static(s.r, s.g, s.b);
                                    }
                                }
                            }

                            // Dynamic Effects
                            Text {
                                text: "Динамические эффекты подсветки:";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text_white_dim;
                            }

                            HorizontalLayout {
                                spacing: 12px;

                                Rectangle {
                                    height: 44px; border-radius: 8px; background: Theme.surface_alt; border-width: 1px; border-color: Theme.border_card;
                                    HorizontalLayout { alignment: center; Text { text: "🌈 Радужный спектр"; font-size: 13px; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.set_rgb_cycle(); } }
                                }
                                Rectangle {
                                    height: 44px; border-radius: 8px; background: Theme.surface_alt; border-width: 1px; border-color: Theme.border_card;
                                    HorizontalLayout { alignment: center; Text { text: "💨 Пульсация (Дыхание)"; font-size: 13px; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.set_rgb_breathe(0, 229, 255); } }
                                }
                                Rectangle {
                                    height: 44px; border-radius: 8px; background: Theme.surface_alt; border-width: 1px; border-color: Theme.border_card;
                                    HorizontalLayout { alignment: center; Text { text: "⭕ Выключить подсветку"; font-size: 13px; font-weight: 700; color: Theme.error_bright; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.set_rgb_off(); } }
                                }
                            }
                        }
                        }

                        // ==========================================
                        // TAB 3: MACRO STUDIO
                        // ==========================================
                        if root.active_tab == 3 : ScrollView {
                        VerticalLayout {
                            spacing: 14px;

                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "Студия макросов & Автокликер";
                                        font-size: 20px;
                                        font-weight: 800;
                                        color: Theme.text_primary;
                                    }
                                    Text {
                                        text: "Создавайте и редактируйте автокликеры, последовательности с задержками и горячие комбинации.";
                                        font-size: 12px;
                                        color: Theme.text_secondary;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    Rectangle {
                                        height: 38px;
                                        border-radius: 6px;
                                        background: Theme.accent;
                                        HorizontalLayout {
                                            padding-left: 14px; padding-right: 14px;
                                            Text {
                                                text: "➕ СОЗДАТЬ МАКРОС";
                                                font-size: 12px;
                                                font-weight: 800;
                                                color: Theme.app_bg;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.open_macro_builder(); }
                                        }
                                    }

                                    if root.active_macro_name != "" : Rectangle {
                                        height: 38px;
                                        border-radius: 6px;
                                        background: Theme.swatch_red;
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px;
                                            Text {
                                                text: "⛔ ОСТАНОВИТЬ: " + root.active_macro_name;
                                                font-size: 11px;
                                                font-weight: 800;
                                                color: Theme.text_primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.stop_all_macros(); }
                                        }
                                    }
                                }
                            }

                            // Macros List
                            VerticalLayout {

                                VerticalLayout {
                                    spacing: 8px;

                                    for item in root.macro_items : MacroRow {
                                        name: item.name;
                                        macro_type: item.macro_type;
                                        is_toggle: item.is_toggle;
                                        steps_count: item.steps_count;
                                        is_custom: item.is_custom;
                                        is_active: root.active_macro_name == item.name;
                                        toggle => { root.toggle_macro(item.name); }
                                        edit => { root.edit_custom_macro(item.name); }
                                        delete => { root.delete_custom_macro(item.name); }
                                    }
                                }
                            }
                        }
                        }

                        // ==========================================
                        // TAB 4: KEYBINDS & BUTTON MAPPING (VISUAL G502)
                        // ==========================================
                        if root.active_tab == 4 : ScrollView {
                        VerticalLayout {
                            spacing: 12px;

                            // Top hook status card
                            Rectangle {
                                height: 68px;
                                border-radius: 10px;
                                background: Theme.card_bg_subtle;
                                border-width: 1px;
                                border-color: root.listener_active ? Theme.success_border : Theme.surface_alt;

                                HorizontalLayout {
                                    padding-left: 18px;
                                    padding-right: 18px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "ФОНОВЫЙ ПЕРЕХВАТЧИК КЛАВИШ (LOW-LEVEL WINDOWS HOOK)";
                                            font-size: 13px;
                                            font-weight: 800;
                                            color: Theme.text_primary;
                                        }
                                        Text {
                                            text: "Слушает физические нажатия кнопок G502 (G1..G11, Tilt Wheel) и клавиш F6..F12 без задержки (0% CPU).";
                                            font-size: 11px;
                                            color: Theme.text_secondary;
                                        }
                                    }

                                    Rectangle {
                                        height: 38px;
                                        border-radius: 6px;
                                        background: root.listener_active ? Theme.success : Theme.surface_elevated;
                                        border-width: 1px;
                                        border-color: root.listener_active ? Theme.success : Theme.border_btn;

                                        HorizontalLayout {
                                            padding-left: 14px; padding-right: 14px;
                                            Text {
                                                text: root.listener_active ? "🟢 ПЕРЕХВАТ ВКЛЮЧЕН" : "⚪ ПЕРЕХВАТ ВЫКЛЮЧЕН";
                                                font-size: 12px;
                                                font-weight: 800;
                                                color: root.listener_active ? Theme.app_bg : Theme.text_secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.toggle_listener(); }
                                        }
                                    }
                                }
                            }

                            // Visual G502 Layout Header
                            Text {
                                text: "Интерактивная карта кнопок Logitech G502 HERO & Горячие клавиши:";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text_white_dim;
                            }

                            // Scrollable Mappings
                            VerticalLayout {

                                VerticalLayout {
                                    spacing: 8px;

                                    for item in root.keybind_items : KeybindRow {
                                        button_id: item.button_id;
                                        button_label: item.button_label;
                                        default_action: item.default_action;
                                        assigned_macro: item.assigned_macro;
                                        is_mouse: item.is_mouse;
                                        assign => { root.open_keybind_picker(item.button_id, item.button_label); }
                                        clear => { root.clear_keybind(item.button_id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            } // Close HorizontalLayout (Main Body: Sidebar + Content Canvas)

            // Divider
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            // ==========================================
            // FOOTER STATUSBAR
            // ==========================================
            Rectangle {
                height: 34px;
                background: Theme.app_bg;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    Text {
                        text: "Статус: " + root.status_msg;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text_secondary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Logitech HID++ 2.0 Native Worker • Win32 SendInput • 100% Offline";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text_muted;
                        vertical-alignment: center;
                    }
                }
            }
        } // Close root VerticalLayout (Header + Main Body + Footer)

        // ==========================================
        // MODAL OVERLAY: MACRO CREATOR & EDITOR
        // ==========================================
        if root.show_macro_builder : Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay;

            TouchArea { /* block clicks outside modal */ }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 740px;
                        height: 620px;
                        border-radius: 12px;
                        background: Theme.card_bg_subtle;
                        border-width: 1px;
                        border-color: Theme.border_default;

                VerticalLayout {
                    padding: 22px;
                    spacing: 12px;

                    // Header
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: root.builder_editing_original != "" ? "✏️ Редактирование макроса" : "➕ Конструктор нового макроса";
                                font-size: 17px;
                                font-weight: 800;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: root.builder_editing_original != "" ? ("Редактирование: " + root.builder_editing_original) : "Создайте автокликер или последовательность клавиш с задержками";
                                font-size: 11px;
                                color: Theme.text_muted;
                            }
                        }

                        Rectangle {
                            width: 28px; height: 28px; border-radius: 6px; background: Theme.surface_elevated;
                            Text { text: "✕"; font-size: 12px; font-weight: 800; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.close_macro_builder(); } }
                        }
                    }

                    // Name Input & Mode in Row
                    HorizontalLayout {
                        spacing: 16px;

                        VerticalLayout {
                            spacing: 4px;
                            width: 320px;
                            Text { text: "Название макроса:"; font-size: 11px; font-weight: 700; color: Theme.text_white_dim; }
                            LineEdit {
                                text: root.builder_name;
                                edited(val) => { root.builder_name = val; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Режим выполнения:"; font-size: 11px; font-weight: 700; color: Theme.text_white_dim; }
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 34px; border-radius: 6px;
                                    background: root.builder_is_toggle ? Theme.accent : Theme.surface_alt;
                                    border-width: 1px; border-color: root.builder_is_toggle ? Theme.accent : Theme.border_btn_hover;
                                    HorizontalLayout { padding-left: 10px; padding-right: 10px; alignment: center; Text { text: "🔄 Автокликер (Toggle)"; font-size: 11px; font-weight: 800; color: root.builder_is_toggle ? Theme.app_bg : Theme.text_white_dim; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.builder_is_toggle = true; } }
                                }
                                Rectangle {
                                    height: 34px; border-radius: 6px;
                                    background: !root.builder_is_toggle ? Theme.success : Theme.surface_alt;
                                    border-width: 1px; border-color: !root.builder_is_toggle ? Theme.success : Theme.border_btn_hover;
                                    HorizontalLayout { padding-left: 10px; padding-right: 10px; alignment: center; Text { text: "⚡ Одиночный (Sequence)"; font-size: 11px; font-weight: 800; color: !root.builder_is_toggle ? Theme.app_bg : Theme.text_white_dim; vertical-alignment: center; } }
                                    TouchArea { clicked => { root.builder_is_toggle = false; } }
                                }
                            }
                        }
                    }

                    // Action Builder Palettes
                    VerticalLayout {
                        spacing: 8px;

                        // Mouse Buttons
                        Text { text: "🖱️ Добавить действия мыши (ЛКМ, ПКМ, СКМ, G4, G5):"; font-size: 11px; font-weight: 700; color: Theme.accent; }
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 28px; border-radius: 5px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: "+ ЛКМ Клик"; font-size: 11px; font-weight: 700; color: Theme.accent; vertical-alignment: center; } }
                                TouchArea { clicked => { root.builder_add_mouse(1, true, 15); root.builder_add_mouse(1, false, 15); } }
                            }
                            Rectangle {
                                height: 28px; border-radius: 5px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: "+ ПКМ Клик"; font-size: 11px; font-weight: 700; color: Theme.accent; vertical-alignment: center; } }
                                TouchArea { clicked => { root.builder_add_mouse(2, true, 15); root.builder_add_mouse(2, false, 15); } }
                            }
                            Rectangle {
                                height: 28px; border-radius: 5px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: "+ СКМ Клик"; font-size: 11px; font-weight: 700; color: Theme.accent; vertical-alignment: center; } }
                                TouchArea { clicked => { root.builder_add_mouse(3, true, 15); root.builder_add_mouse(3, false, 15); } }
                            }
                            Rectangle {
                                height: 28px; border-radius: 5px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: "+ Боковая G4"; font-size: 11px; font-weight: 700; color: Theme.accent; vertical-alignment: center; } }
                                TouchArea { clicked => { root.builder_add_mouse(4, true, 15); root.builder_add_mouse(4, false, 15); } }
                            }
                            Rectangle {
                                height: 28px; border-radius: 5px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: "+ Боковая G5"; font-size: 11px; font-weight: 700; color: Theme.accent; vertical-alignment: center; } }
                                TouchArea { clicked => { root.builder_add_mouse(5, true, 15); root.builder_add_mouse(5, false, 15); } }
                            }
                            Rectangle {
                                height: 28px; border-radius: 5px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: "+ Зажать ЛКМ"; font-size: 10px; font-weight: 700; color: Theme.purple_text; vertical-alignment: center; } }
                                TouchArea { clicked => { root.builder_add_mouse(1, true, 10); } }
                            }
                            Rectangle {
                                height: 28px; border-radius: 5px; background: Theme.surface_btn; border-width: 1px; border-color: Theme.border_btn_hover;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: "+ Отпустить ЛКМ"; font-size: 10px; font-weight: 700; color: Theme.purple_text; vertical-alignment: center; } }
                                TouchArea { clicked => { root.builder_add_mouse(1, false, 10); } }
                            }
                        }

                        // Keyboard Keys
                        Text { text: "⌨️ Добавить клавиши клавиатуры:"; font-size: 11px; font-weight: 700; color: Theme.success; }
                        HorizontalLayout {
                            spacing: 5px;
                            for k in root.quick_keys : QuickKeyButton {
                                label: k.label;
                                vk: k.vk;
                                clicked(code) => {
                                    root.builder_add_key(code, true, 10);
                                    root.builder_add_key(code, false, 10);
                                }
                            }
                        }

                        // Delays & Controls
                        Text { text: "⏱️ Паузы и управление цепочкой:"; font-size: 11px; font-weight: 700; color: Theme.warning; }
                        HorizontalLayout {
                            spacing: 6px;
                            for d in root.quick_delays : QuickDelayButton {
                                delay_ms: d;
                                clicked(ms) => {
                                    root.builder_add_delay(ms);
                                }
                            }

                            // Clear all button
                            Rectangle {
                                height: 26px; border-radius: 4px; background: Theme.error_btn_bg; border-width: 1px; border-color: Theme.error_border;
                                HorizontalLayout { padding-left: 10px; padding-right: 10px; Text { text: "Очистить все"; font-size: 10px; font-weight: 700; color: Theme.error_bright; vertical-alignment: center; } }
                                TouchArea { clicked => { root.builder_clear_steps(); } }
                            }
                        }
                    }

                    // Steps sequence preview
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Цепочка действий макроса (" + root.builder_steps.length + " шагов):"; font-size: 11px; font-weight: 700; color: Theme.text_white_dim; }

                        ScrollView {
                            height: 160px;
                            VerticalLayout {
                                spacing: 4px;
                                for step[idx] in root.builder_steps : StepRow {
                                    idx: idx;
                                    step_text: step;
                                    move_up => { root.builder_move_step_up(idx); }
                                    move_down => { root.builder_move_step_down(idx); }
                                    remove => { root.builder_remove_step(idx); }
                                }
                            }
                        }
                    }

                    // Actions
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;

                        Rectangle {
                            height: 38px; border-radius: 6px; background: Theme.surface_elevated;
                            HorizontalLayout { padding-left: 16px; padding-right: 16px; Text { text: "Отмена"; font-size: 12px; font-weight: 700; color: Theme.text_secondary; vertical-alignment: center; } }
                            TouchArea { clicked => { root.close_macro_builder(); } }
                        }

                        Rectangle {
                            height: 38px; border-radius: 6px; background: Theme.success;
                            HorizontalLayout { padding-left: 18px; padding-right: 18px; Text { text: "💾 СОХРАНИТЬ МАКРОС"; font-size: 12px; font-weight: 800; color: Theme.app_bg; vertical-alignment: center; } }
                            TouchArea { clicked => { root.builder_save_macro(root.builder_editing_original, root.builder_name, root.builder_is_toggle); } }
                        }
                    }
                }
            }
            }
            }
        }

        // ==========================================
        // MODAL OVERLAY: KEYBIND PICKER
        // ==========================================
        if root.show_bind_picker : Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay;

            TouchArea { /* block clicks outside modal */ }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 540px;
                        height: 500px;
                        border-radius: 12px;
                        background: Theme.card_bg_subtle;
                        border-width: 1px;
                        border-color: Theme.border_default;

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    // Header
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Назначение макроса на кнопку";
                                font-size: 16px;
                                font-weight: 800;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Кнопка: " + root.picker_button_name + " [" + root.picker_button_id + "]";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.accent;
                            }
                        }
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 6px; background: Theme.surface_elevated;
                            Text { text: "✕"; font-size: 12px; font-weight: 800; color: Theme.text_primary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.close_keybind_picker(); } }
                        }
                    }

                    // Reset to default button
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: Theme.error_subtle;
                        border-width: 1px;
                        border-color: Theme.error_border;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; alignment: center;
                            Text {
                                text: "✕ Сбросить на стандартное действие мыши";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.error_bright;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => { root.clear_keybind(root.picker_button_id); }
                        }
                    }

                    Text {
                        text: "Выберите макрос из списка доступных:";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text_secondary;
                    }

                    // Available macros list
                    ScrollView {
                        height: 310px;
                        VerticalLayout {
                            spacing: 6px;

                            for m in root.macro_items : Rectangle {
                                height: 44px;
                                border-radius: 6px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border_card;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: m.is_toggle ? "🔄" : "⚡"; font-size: 14px; vertical-alignment: center; }
                                        Text { text: m.name; font-size: 13px; font-weight: 700; color: Theme.text_primary; vertical-alignment: center; }
                                    }

                                    Rectangle {
                                        height: 26px; border-radius: 4px; background: Theme.accent;
                                        HorizontalLayout {
                                            padding-left: 10px; padding-right: 10px;
                                            Text { text: "Выбрать"; font-size: 11px; font-weight: 800; color: Theme.app_bg; vertical-alignment: center; }
                                        }
                                    }
                                }
                                TouchArea {
                                    clicked => { root.assign_keybind(root.picker_button_id, m.name); }
                                }
                            }
                        }
                    }
                }
            }
        }
            }
            }
    }
