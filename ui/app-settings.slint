import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export component AppSettings inherits Rectangle {
    // -1: unavailable, 0: off, 1: this executable, 2: another copy, 3: occupied.
    in property <int> startup-state: -1;
    in property <string> startup-error: "";
    callback set-startup(bool);

    // Update checker & build verification
    in property <string> app-version: "1.0.0";
    in property <string> build-git-hash: "";
    in property <string> local-sha256: "";
    // 0: idle, 1: checking, 2: up-to-date/matched, 3: update available, 4: error
    in property <int> update-status-kind: 0;
    in property <string> update-status-msg: "Нажмите «Проверить обновления», чтобы сравнить локальную сборку с GitHub Releases.";
    in property <string> remote-tag: "";
    in property <string> remote-sha256: "";
    in property <string> release-url: "";

    callback check-update();
    callback open-releases();
    callback open-repository();

    background: Theme.app_bg;

    ScrollView {
        VerticalLayout {
            padding-left: 4px;
            padding-right: 12px;
            spacing: 20px;
            alignment: start;

            Text {
                text: "Настройки приложения";
                font-size: Theme.font_display;
                font-weight: 800;
                color: Theme.text_primary;
            }

            // ==========================================
            // CARD 1: АВТОЗАГРУЗКА
            // ==========================================
            Rectangle {
                border-radius: Theme.radius_lg;
                background: Theme.card_bg_subtle;
                border-width: 1px;
                border-color: Theme.border_card;
                vertical-stretch: 0;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: "Автозагрузка с Windows";
                        font-size: Theme.font_lg;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }

                    Text {
                        text: root.startup-state == 1 ? "Включена для этого файла приложения."
                            : root.startup-state == 2 ? "Включена для другой копии приложения."
                            : root.startup-state == 3 ? "Имя записи занято другой программой."
                            : root.startup-state == 0 ? "Выключена."
                            : "Не удалось прочитать состояние автозагрузки.";
                        color: root.startup-state == 1 ? Theme.success : Theme.text_secondary;
                        font-size: Theme.font_body;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "После входа в Windows откроется окно приложения. Если переместите EXE, включите автозагрузку заново.";
                        color: Theme.text_secondary;
                        font-size: Theme.font_body_sm;
                        wrap: word-wrap;
                    }

                    if root.startup-error != "" : Text {
                        text: root.startup-error;
                        color: Theme.error_text;
                        font-size: Theme.font_body_sm;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;

                        if root.startup-state >= 0 && root.startup-state <= 2 : Rectangle {
                            height: 36px;
                            border-radius: Theme.radius_md;
                            background: root.startup-state == 1 ? Theme.surface_btn : Theme.accent;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                Text {
                                    text: root.startup-state == 1 ? "Выключить" : root.startup-state == 2 ? "Использовать этот файл" : "Включить автозагрузку";
                                    color: root.startup-state == 1 ? Theme.text_primary : Theme.app_bg;
                                    font-size: Theme.font_body_sm;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.set-startup(root.startup-state != 1); }
                            }
                        }

                        if root.startup-state == 2 : Rectangle {
                            height: 36px;
                            border-radius: Theme.radius_md;
                            background: Theme.surface_btn;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px;
                                Text {
                                    text: "Выключить автозагрузку";
                                    color: Theme.text_primary;
                                    font-size: Theme.font_body_sm;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.set-startup(false); }
                            }
                        }
                    }
                }
            }

            // ==========================================
            // CARD 2: ОБНОВЛЕНИЯ И ПРОВЕРКА ХЕША СБОРКИ
            // ==========================================
            Rectangle {
                border-radius: Theme.radius_lg;
                background: Theme.card_bg_subtle;
                border-width: 1px;
                border-color: Theme.border_card;
                vertical-stretch: 0;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Обновления и проверка хеша сборки";
                            font-size: Theme.font_lg;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }
                        Rectangle {
                            height: 24px;
                            border-radius: Theme.radius_sm;
                            background: Theme.accent_light;
                            border-width: 1px;
                            border-color: Theme.accent_border;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                Text {
                                    text: "v" + root.app-version + " (" + root.build-git-hash + ")";
                                    color: Theme.accent;
                                    font-size: Theme.font_caption;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Local SHA-256 info
                    Rectangle {
                        border-radius: Theme.radius_md;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border_subtle;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: "Локальный SHA-256 текущего исполняемого файла:";
                                color: Theme.text_secondary;
                                font-size: Theme.font_caption;
                                font-weight: 600;
                            }
                            Text {
                                text: root.local-sha256 != "" ? root.local-sha256 : "вычисляется...";
                                color: Theme.text_heading;
                                font-size: Theme.font_caption;
                                font-family: "Consolas";
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Status display message
                    Rectangle {
                        border-radius: Theme.radius_md;
                        background: root.update-status-kind == 2 ? Theme.success_subtle
                                  : root.update-status-kind == 3 ? Theme.accent_light
                                  : root.update-status-kind == 4 ? Theme.error_subtle
                                  : Theme.surface_subtle;
                        border-width: 1px;
                        border-color: root.update-status-kind == 2 ? Theme.success_border
                                    : root.update-status-kind == 3 ? Theme.accent_border
                                    : root.update-status-kind == 4 ? Theme.error_border
                                    : Theme.border_subtle;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: root.update-status-msg;
                                color: root.update-status-kind == 2 ? Theme.success
                                     : root.update-status-kind == 3 ? Theme.accent
                                     : root.update-status-kind == 4 ? Theme.error_text
                                     : Theme.text_secondary;
                                font-size: Theme.font_body_sm;
                                wrap: word-wrap;
                            }
                            if root.remote-sha256 != "" : Text {
                                text: "SHA-256 релиза GitHub: " + root.remote-sha256;
                                color: Theme.text_secondary;
                                font-size: Theme.font_caption;
                                font-family: "Consolas";
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 12px;

                        // Check button
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius_md;
                            background: root.update-status-kind == 1 ? Theme.surface_btn : Theme.accent;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                Text {
                                    text: root.update-status-kind == 1 ? "⏳ Проверка..." : "🔍 Проверить обновления";
                                    color: root.update-status-kind == 1 ? Theme.text_secondary : Theme.app_bg;
                                    font-size: Theme.font_body_sm;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                enabled: root.update-status-kind != 1;
                                clicked => { root.check-update(); }
                            }
                        }

                        // Open releases page button
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius_md;
                            background: Theme.surface_btn;
                            border-width: 1px;
                            border-color: Theme.border_btn_hover;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px;
                                Text {
                                    text: "📦 Страница релизов GitHub";
                                    color: Theme.text_primary;
                                    font-size: Theme.font_body_sm;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-releases(); }
                            }
                        }
                    }
                }
            }

            // ==========================================
            // CARD 3: О ПРОЕКТЕ И РЕПОЗИТОРИЙ GITHUB
            // ==========================================
            Rectangle {
                border-radius: Theme.radius_lg;
                background: Theme.card_bg_subtle;
                border-width: 1px;
                border-color: Theme.border_card;
                vertical-stretch: 0;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: "Репозиторий проекта";
                        font-size: Theme.font_lg;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }

                    Text {
                        text: "Исходный код приложения полностью открыт и доступен на GitHub. Вы можете предложить улучшение, создать Issue или форкнуть проект.";
                        color: Theme.text_secondary;
                        font-size: Theme.font_body_sm;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 12px;

                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius_md;
                            background: Theme.surface_btn;
                            border-width: 1px;
                            border-color: Theme.accent_border;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                Text {
                                    text: "🌐 Перейти в репозиторий GitHub";
                                    color: Theme.accent;
                                    font-size: Theme.font_body_sm;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-repository(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
