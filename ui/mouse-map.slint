import { Theme } from "theme.slint";

component MousePoint inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 36px; height: 36px;
    border-radius: 18px;
    background: point.has-hover ? Theme.accent : Theme.surface_elevated;
    border-width: 2px;
    border-color: Theme.accent;
    Text {
        text: root.label;
        color: point.has-hover ? Theme.app_bg : Theme.text_primary;
        font-size: Theme.font_caption;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    point := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component MouseMap inherits Rectangle {
    callback select(string);
    background: Theme.app_bg;
    min-width: 420px; min-height: 500px;
    Image {
        source: @image-url("assets/g502.svg");
        width: 270px; height: 423px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    MousePoint { label: "G1"; x: parent.width / 2 - 65px; y: parent.height / 2 - 170px; clicked => { root.select("G1"); } }
    MousePoint { label: "G2"; x: parent.width / 2 + 50px; y: parent.height / 2 - 150px; clicked => { root.select("G2"); } }
    MousePoint { label: "G3"; x: parent.width / 2 - 18px; y: parent.height / 2 - 126px; clicked => { root.select("G3"); } }
    MousePoint { label: "G4"; x: parent.width / 2 - 142px; y: parent.height / 2 + 25px; clicked => { root.select("G4"); } }
    MousePoint { label: "G5"; x: parent.width / 2 - 134px; y: parent.height / 2 - 18px; clicked => { root.select("G5"); } }
    MousePoint { label: "G6"; x: parent.width / 2 - 148px; y: parent.height / 2 + 80px; clicked => { root.select("G6"); } }
    MousePoint { label: "G7"; x: parent.width / 2 - 82px; y: parent.height / 2 - 88px; clicked => { root.select("G7"); } }
    MousePoint { label: "G8"; x: parent.width / 2 - 110px; y: parent.height / 2 - 130px; clicked => { root.select("G8"); } }
    MousePoint { label: "G9"; x: parent.width / 2 - 18px; y: parent.height / 2 - 35px; clicked => { root.select("G9"); } }
    MousePoint { label: "G10"; x: parent.width / 2 - 58px; y: parent.height / 2 - 126px; clicked => { root.select("G10"); } }
    MousePoint { label: "G11"; x: parent.width / 2 + 22px; y: parent.height / 2 - 126px; clicked => { root.select("G11"); } }
}
